# Mẫu file cấu hình.
# Trên Hostinger: tạo file tên binbin.env ở thư mục CHA của public_html
#   (ví dụ /home/u123456789/domains/binbinmkt.online/binbin.env), không đặt trong public_html.
# Chạy thử trên máy: chép thành .env cạnh index.php.

# Môi trường: development | production
APP_ENV=development
# Địa chỉ website, không có dấu / ở cuối
APP_URL=http://localhost:8000
# Chuỗi bí mật mã hoá phiên đăng nhập — bắt buộc trên production (>= 32 ký tự ngẫu nhiên)
SESSION_SECRET=change-me-to-a-long-random-string

# Database: sqlite (chạy thử trên máy) | mysql (Hostinger)
DB_CLIENT=sqlite
SQLITE_PATH=data/binbin.db
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Tài khoản admin đầu tiên (chỉ tạo khi database chưa có user nào). Đăng nhập bằng ADMIN_USERNAME
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@binbinhotel.vn
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị viên

# Brevo — để trống BREVO_API_KEY thì email chạy chế độ thử (không gửi thật)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Bin Bin Hotel
# Chuỗi bí mật trong URL webhook: APP_URL/webhooks/brevo/<BREVO_WEBHOOK_SECRET>
BREVO_WEBHOOK_SECRET=

# Thư mục lưu ảnh/video tải lên. Trên Hostinger đặt ngoài public_html để không mất khi deploy lại,
# ví dụ: ../binbin-uploads (tính từ public_html)
UPLOAD_DIR=uploads

# Mật khẩu cho link chạy việc nền qua web (APP_URL/cron/<CRON_KEY>), chỉ cần nếu không đặt được cron bằng lệnh php.
# Để trống thì link này tắt. Ít nhất 16 ký tự.
CRON_KEY=

# ---------- Tự động lấy số liệu kênh ----------
# Google Maps: Google Cloud → bật "Places API (New)" → tạo API key
GOOGLE_PLACES_API_KEY=
# Facebook Page: developers.facebook.com → tạo app loại Business
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0
# TikTok: developers.tiktok.com → app có Login Kit + Display API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Zalo OA: developers.zalo.me → tạo ứng dụng, liên kết với OA
ZALO_APP_ID=
ZALO_APP_SECRET=
# Khoá mã hoá token kết nối (để trống thì dùng SESSION_SECRET).
# Đổi khoá này thì phải kết nối lại các kênh.
ENCRYPTION_KEY=

# ---------- Phân tích bằng AI (Claude) ----------
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Email liên hệ hiện trên trang Chính sách bảo mật và Điều khoản (/chinh-sach-bao-mat, /dieu-khoan)
CONTACT_EMAIL=
# Mã xác thực tên miền (chỉ phần content của thẻ meta) nếu Zalo / Facebook yêu cầu
ZALO_SITE_VERIFICATION=
FACEBOOK_DOMAIN_VERIFICATION=
