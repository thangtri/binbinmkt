# Môi trường: development | production
NODE_ENV=development
PORT=3000
# Địa chỉ website (dùng cho link huỷ đăng ký trong email)
APP_URL=http://localhost:3000
# Chuỗi bí mật ký cookie đăng nhập — bắt buộc đổi trên production (>= 32 ký tự ngẫu nhiên)
SESSION_SECRET=change-me-to-a-long-random-string

# Database: sqlite (chạy thử trên máy) | mysql (Hostinger)
DB_CLIENT=sqlite
SQLITE_PATH=./data/binbin.db
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Tài khoản admin đầu tiên (chỉ tạo khi database chưa có user nào)
ADMIN_EMAIL=admin@binbinhotel.vn
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị viên

# Brevo — để trống BREVO_API_KEY thì email chạy chế độ thử (không gửi thật)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Bin Bin Hotel
# Chuỗi bí mật trong URL webhook: APP_URL/webhooks/brevo/<BREVO_WEBHOOK_SECRET>
BREVO_WEBHOOK_SECRET=

# Thư mục lưu ảnh/video tải lên. Trên Hostinger nên đặt ngoài thư mục code
# để không bị mất khi deploy lại, ví dụ: /home/<user>/binbin-uploads
UPLOAD_DIR=./uploads
