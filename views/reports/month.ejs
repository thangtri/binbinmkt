<%- include('../partials/top') %>
<%
  const sign = (v, dec) => (v == null ? '—' : (v > 0 ? '+' : '') + (dec ? Number(v).toFixed(dec) : num(v)));
  const cls = (v) => (v > 0 ? 'up' : v < 0 ? 'down' : '');
  const val = (v, dec) => (v == null ? '—' : dec ? Number(v).toFixed(dec) : num(v));
  const pct = (a, b) => (b ? Math.round((a / b) * 100) + '%' : '—');
  const totalUsed = r.offers.reduce((s, o) => s + o.used, 0);
  const totalRevenue = r.offers.reduce((s, o) => s + o.revenue, 0);
  const totalFollow = r.channels.reduce((s, c) => s + (c.followers.change || 0), 0);
%>
<header class="page-head">
  <div>
    <h1>Báo cáo tháng <%= r.month.slice(5) %>/<%= r.month.slice(0, 4) %></h1>
    <p class="sub"><%= d.dmy(r.from) %> – <%= d.dmy(r.to) %></p>
  </div>
  <div class="toolbar no-print">
    <div class="seg" role="group" aria-label="Chọn tháng">
      <a href="/reports?m=<%= prev %>" aria-label="Tháng trước"><%- icon('left') %></a>
      <a href="/reports">Tháng này</a>
      <a href="/reports?m=<%= next %>" aria-label="Tháng sau"><%- icon('right') %></a>
    </div>
    <a class="btn" href="/reports/<%= r.month %>.csv"><%- icon('upload') %> Tải Excel (.csv)</a>
    <button class="btn" type="button" data-print><%- icon('file') %> In / Lưu PDF</button>
  </div>
</header>

<section class="kpis">
  <div class="kpi"><span class="kpi-label">Bài đã đăng</span><span class="kpi-value"><%= num(r.posts.published) %></span><span class="kpi-note">trên cả 4 kênh</span></div>
  <div class="kpi"><span class="kpi-label">Người theo dõi tăng thêm</span><span class="kpi-value <%= cls(totalFollow) %>"><%= sign(totalFollow) %></span><span class="kpi-note">Facebook, TikTok, Zalo OA</span></div>
  <div class="kpi"><span class="kpi-label">Lượt dùng mã ưu đãi</span><span class="kpi-value"><%= num(totalUsed) %></span><span class="kpi-note"><%= totalRevenue ? num(totalRevenue) + 'đ doanh thu ghi nhận' : 'chưa ghi doanh thu' %></span></div>
  <div class="kpi"><span class="kpi-label">Email đã gửi</span><span class="kpi-value"><%= num(r.emails.reduce((s, e) => s + e.sent, 0)) %></span><span class="kpi-note"><%= r.emails.length %> chiến dịch</span></div>
</section>

<section class="panel ai-panel">
  <div class="panel-head"><h2>Nhận xét của AI</h2><% if (insight) { %><span class="muted small"><%= d.dmyhm(insight.created_at) %></span><% } %></div>
  <% if (insight) { %>
    <p class="ai-summary"><%= insight.summary %></p>
    <div class="ai-cols">
      <% if (insight.highlights.length) { %><div><h3>Điểm tốt</h3><ul><% for (const x of insight.highlights) { %><li><%= x %></li><% } %></ul></div><% } %>
      <% if (insight.concerns.length) { %><div><h3>Cần chú ý</h3><ul><% for (const x of insight.concerns) { %><li><%= x %></li><% } %></ul></div><% } %>
    </div>
    <% if (insight.recommendations.length) { %><div class="ai-reco"><h3>Đề xuất cho tháng sau</h3><ul><% for (const x of insight.recommendations) { %><li><%= x %></li><% } %></ul></div><% } %>
  <% } else { %>
    <p class="empty"><%= aiReady ? 'Chưa có nhận xét cho tháng này.' : 'Chưa bật AI (cần ANTHROPIC_API_KEY).' %></p>
  <% } %>
  <% if (aiReady && can('channel:edit')) { %>
    <form method="post" action="/reports/<%= r.month %>/ai" class="ai-run no-print">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn btn-small" type="submit" data-busy="AI đang đọc báo cáo…"><%= insight ? 'Nhận xét lại' : 'Nhờ AI nhận xét' %></button>
    </form>
  <% } %>
</section>

<div class="report-grid">
  <section class="panel panel-flush">
    <div class="panel-head pad"><h2>Kênh mạng xã hội</h2></div>
    <table class="table table-rows">
      <thead><tr><th>Kênh</th><th class="num">Theo dõi cuối kỳ</th><th class="num">Tăng/giảm</th><th class="num">Bài</th><th class="num">Lượt xem</th><th class="num">Tương tác</th></tr></thead>
      <tbody>
        <% for (const c of r.channels) { %>
          <tr><td><%- include('../partials/chips', { kind: 'channel', value: c.key }) %></td>
            <td class="num"><%= val(c.followers.end) %></td>
            <td class="num <%= cls(c.followers.change) %>"><%= sign(c.followers.change) %></td>
            <td class="num"><%= num(c.posts) %></td><td class="num"><%= num(c.views) %></td><td class="num"><%= num(c.interactions) %></td></tr>
        <% } %>
      </tbody>
    </table>
  </section>

  <section class="panel panel-flush">
    <div class="panel-head pad"><h2>Google Maps theo chi nhánh</h2></div>
    <table class="table table-rows">
      <thead><tr><th>Chi nhánh</th><th class="num">Điểm</th><th class="num">Thay đổi</th><th class="num">Đánh giá</th><th class="num">Mới trong tháng</th></tr></thead>
      <tbody>
        <% for (const b of r.branches) { %>
          <tr><td><%= b.name %></td>
            <td class="num"><%= b.rating.end == null ? '—' : Number(b.rating.end).toFixed(1) + '★' %></td>
            <td class="num <%= cls(b.rating.change) %>"><%= sign(b.rating.change, 1) %></td>
            <td class="num"><%= val(b.reviews.end) %></td>
            <td class="num <%= cls(b.reviews.change) %>"><%= sign(b.reviews.change) %></td></tr>
        <% } %>
      </tbody>
    </table>
    <% if (r.rivals.length) { %>
      <table class="table table-rows">
        <thead><tr><th>Đối thủ</th><th>Gần chi nhánh</th><th class="num">Điểm</th><th class="num">Mới trong tháng</th></tr></thead>
        <tbody>
          <% for (const c of r.rivals) { %>
            <tr><td><%= c.name %></td><td class="muted"><%= c.branch || '' %></td><td class="num"><%= c.rating == null ? '—' : Number(c.rating).toFixed(1) + '★' %></td><td class="num"><%= sign(c.newReviews) %></td></tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </section>

  <section class="panel panel-flush">
    <div class="panel-head pad"><h2>Bài hiệu quả nhất</h2></div>
    <% if (!r.posts.top.length) { %><p class="empty pad">Chưa có bài nào đăng trong tháng.</p><% } else { %>
      <table class="table table-rows">
        <thead><tr><th>Bài</th><th class="num">Xem</th><th class="num">Tương tác</th></tr></thead>
        <tbody>
          <% for (const p of r.posts.top) { %>
            <tr><td><a href="/posts/<%= p.id %>"><%= p.title %></a><small class="muted block"><%= d.dmy(p.published_at) %>, <%= p.format || '' %></small></td><td class="num"><%= num(p.views) %></td><td class="num"><%= num(p.interactions) %></td></tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </section>

  <section class="panel panel-flush">
    <div class="panel-head pad"><h2>Ưu đãi và mã giảm giá</h2></div>
    <% if (!r.offers.length) { %><p class="empty pad">Chưa có khách dùng mã trong tháng.</p><% } else { %>
      <table class="table table-rows">
        <thead><tr><th>Ưu đãi</th><th>Kênh</th><th class="num">Lượt dùng</th><th class="num">Đêm</th><th class="num">Doanh thu</th></tr></thead>
        <tbody>
          <% for (const o of r.offers) { %>
            <tr><td><%= o.title %></td><td><%= channelNames[o.channel] || o.channel %></td><td class="num"><%= num(o.used) %></td><td class="num"><%= num(o.nights) %></td><td class="num"><%= o.revenue ? num(o.revenue) + 'đ' : '—' %></td></tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </section>

  <section class="panel panel-flush">
    <div class="panel-head pad"><h2>Email marketing</h2></div>
    <% if (!r.emails.length) { %><p class="empty pad">Không gửi chiến dịch nào trong tháng.</p><% } else { %>
      <table class="table table-rows">
        <thead><tr><th>Chiến dịch</th><th class="num">Gửi</th><th class="num">Mở</th><th class="num">Nhấp</th></tr></thead>
        <tbody>
          <% for (const e of r.emails) { %>
            <tr><td><%= e.name %><small class="muted block"><%= d.dmy(e.sent_at) %></small></td><td class="num"><%= num(e.sent) %></td><td class="num"><%= pct(e.opened, e.sent) %></td><td class="num"><%= pct(e.clicked, e.sent) %></td></tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </section>
</div>
<%- include('../partials/bottom') %>
