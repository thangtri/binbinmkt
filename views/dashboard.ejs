<%- include('partials/top') %>
<%
  const firstName = user.name.trim();
  const weekTotal = Object.values(week).reduce((s, n) => s + n, 0);
  const pct = (a, b) => (b ? Math.round((a / b) * 100) + '%' : '—');
%>
<header class="welcome<%= hotelPhoto ? ' has-photo' : '' %>">
  <div class="welcome-text">
    <p class="date-line"><%= d.weekday(today, true) %>, <%= d.dmy(today) %></p>
    <h1>Chào <%= firstName %></h1>
    <p class="summary">
      <% if (weekTotal) { %>Tuần này có <strong><%= weekTotal %> bài</strong> trên lịch.<% } else { %>Tuần này chưa có bài nào trên lịch.<% } %>
      <% if (pendingCount) { %><a href="/posts?status=pending"><strong><%= pendingCount %> bài</strong> đang chờ duyệt</a>.<% } else { %>Không có bài nào chờ duyệt.<% } %>
      Tháng này đã đăng <strong><%= publishedMonth %> bài</strong>.
    </p>
    <div class="welcome-actions">
      <% if (can('post:create')) { %><a class="btn btn-primary" href="/posts/new"><%- icon('plus') %> Soạn bài</a><% } %>
      <a class="btn" href="/calendar"><%- icon('calendar') %> Mở lịch đăng bài</a>
    </div>
  </div>
  <% if (hotelPhoto) { %>
    <div class="welcome-photo" style="background-image:url('<%= hotelPhoto %>')" role="img" aria-label="Ảnh Bin Bin Hotel"></div>
  <% } else { %>
    <img class="welcome-mark" src="/public/img/logo.png" alt="" width="104" height="104">
  <% } %>
</header>

<% const noPost = upcoming.filter((e) => !e.post_count).length; %>
<nav class="quick" aria-label="Việc cần chú ý">
  <a class="quick-tile<%= due.length ? ' is-alert' : '' %>" href="/calendar">
    <span class="quick-icon"><%- icon('calendar') %></span>
    <span><strong><%= due.length %></strong><small>bài cần đăng hôm nay</small></span>
  </a>
  <a class="quick-tile<%= pendingCount ? ' is-alert' : '' %>" href="/posts?status=pending">
    <span class="quick-icon"><%- icon('file') %></span>
    <span><strong><%= pendingCount %></strong><small>bài chờ duyệt</small></span>
  </a>
  <a class="quick-tile<%= noPost ? ' is-alert' : '' %>" href="/events">
    <span class="quick-icon"><%- icon('flag') %></span>
    <span><strong><%= upcoming.length %></strong><small>sự kiện sắp tới<%= noPost ? ', ' + noPost + ' chưa có bài' : '' %></small></span>
  </a>
  <a class="quick-tile" href="/email/campaigns">
    <span class="quick-icon"><%- icon('mail') %></span>
    <span><strong><%= campaign ? pct(Number(campaign.stats.opened), Number(campaign.stats.total)) : '—' %></strong><small>tỷ lệ mở email gần nhất</small></span>
  </a>
</nav>

<div class="dash">
  <div class="dash-main">
    <section class="panel">
      <div class="panel-head">
        <h2>Cần đăng hôm nay</h2>
        <a href="/calendar">Xem lịch</a>
      </div>
      <% if (!due.length) { %>
        <p class="empty">Hôm nay không có bài nào đến giờ đăng.</p>
      <% } else { %>
        <ul class="due">
          <% for (const p of due) { const late = p.scheduled_at.slice(0, 10) < today; %>
            <li>
              <div class="due-time<%= late ? ' is-late' : '' %>">
                <strong><%= d.hm(p.scheduled_at) %></strong>
                <small><%= late ? 'Trễ từ ' + d.dm(p.scheduled_at) : 'Hôm nay' %></small>
              </div>
              <div class="due-body">
                <span class="muted small"><%= p.format || 'Bài đăng' %>, cả 4 kênh</span>
                <a href="/posts/<%= p.id %>" class="due-title"><%= p.title %></a>
              </div>
              <% if (can('post:publish')) { %>
                <form method="post" action="/posts/<%= p.id %>/publish" class="due-action">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <input type="hidden" name="back" value="dashboard">
                  <button class="btn btn-small" type="submit"><%- icon('check') %> Đã đăng</button>
                </form>
              <% } %>
            </li>
          <% } %>
        </ul>
      <% } %>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>Chờ duyệt</h2>
        <% if (pendingCount > pending.length) { %><a href="/posts?status=pending">Xem cả <%= pendingCount %> bài</a><% } %>
      </div>
      <% if (!pending.length) { %>
        <p class="empty">Không có bài nào chờ duyệt.</p>
      <% } else { %>
        <table class="table">
          <thead><tr><th>Bài</th><th>Ngày đăng</th><th class="hide-sm">Người soạn</th><% if (user.role === 'admin') { %><th><span class="sr-only">Duyệt</span></th><% } %></tr></thead>
          <tbody>
          <% for (const p of pending) { %>
            <tr>
              <td><a href="/posts/<%= p.id %>"><%= p.title %></a></td>
              <td class="nowrap"><%= p.scheduled_at ? d.dmyhm(p.scheduled_at) : 'Chưa chọn' %></td>
              <td class="hide-sm"><%= p.author_name || '' %></td>
              <% if (user.role === 'admin') { %>
                <td class="right">
                  <form method="post" action="/posts/<%= p.id %>/approve">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <input type="hidden" name="back" value="dashboard">
                    <button class="btn btn-small" type="submit">Duyệt</button>
                  </form>
                </td>
              <% } %>
            </tr>
          <% } %>
          </tbody>
        </table>
      <% } %>
    </section>

    <section class="panel">
      <div class="panel-head"><h2>Hoạt động gần đây</h2></div>
      <% if (!activity.length) { %>
        <p class="empty">Chưa có hoạt động nào.</p>
      <% } else { %>
        <ul class="feed">
          <% for (const a of activity) { %>
            <li><span class="feed-who"><%= a.user_name || 'Hệ thống' %></span> <%= ({ 'post.create': 'tạo bài', 'post.update': 'sửa bài', 'post.submit': 'gửi duyệt', 'post.approve': 'duyệt bài', 'post.reject': 'trả bài', 'post.publish': 'đã đăng', 'post.reschedule': 'đổi ngày', 'post.delete': 'xoá bài', 'event.create': 'thêm sự kiện', 'event.update': 'sửa sự kiện', 'event.delete': 'xoá sự kiện', 'campaign.create': 'tạo chiến dịch', 'campaign.send': 'gửi chiến dịch', 'campaign.delete': 'xoá chiến dịch', 'contact.import': 'nhập danh bạ', 'contact.delete': 'xoá liên hệ', 'channel.update': 'sửa kênh', 'channel.stats': 'ghi số liệu', 'channel.sync': 'cập nhật số liệu', 'channel.connect': 'kết nối kênh', 'channel.disconnect': 'ngắt kết nối kênh', 'channel.analyze': 'chạy phân tích AI', 'user.create': 'tạo tài khoản', 'user.email': 'đổi email', 'settings.update': 'sửa thông tin khách sạn', 'branch.create': 'thêm chi nhánh', 'offer.create': 'tạo ưu đãi', 'offer.update': 'sửa ưu đãi', 'offer.redeem': 'ghi nhận mã', 'plan.create': 'nhờ AI lập kế hoạch', 'plan.apply': 'tạo bài từ kế hoạch', 'competitor.add': 'thêm đối thủ', 'report.ai': 'nhờ AI nhận xét báo cáo', 'branch.update': 'sửa chi nhánh', 'post.ai': 'nhờ AI viết bài', 'post.autopublish': 'tự đăng bài', 'post.publishnow': 'bấm đăng ngay', 'user.update': 'sửa tài khoản' })[a.action] || a.action %>
              <span class="feed-what"><%= a.summary %></span>
              <time><%= d.dmyhm(a.created_at) %></time></li>
          <% } %>
        </ul>
      <% } %>
    </section>
  </div>

  <div class="dash-side">
    <section class="panel">
      <div class="panel-head"><h2>Sự kiện sắp tới</h2><a href="/events">Tất cả</a></div>
      <% if (!upcoming.length) { %>
        <p class="empty">45 ngày tới chưa có sự kiện nào. <a href="/events/new">Thêm sự kiện</a></p>
      <% } else { %>
        <ol class="upcoming">
          <% for (const ev of upcoming) { %>
            <li>
              <div class="up-date"><strong><%= ev.occ_start.slice(8, 10) %></strong><small>Th<%= Number(ev.occ_start.slice(5, 7)) %></small></div>
              <div>
                <p class="up-title"><%= ev.title %></p>
                <p class="up-meta">
                  <%= d.relative(ev.occ_start) %>,
                  <% if (ev.post_count) { %><%= ev.post_count %> bài đã lên kế hoạch
                  <% } else { %><span class="warn">chưa có bài</span><% if (can('post:create')) { %> <a href="/posts/new?event=<%= ev.id %>&date=<%= d.addDays(ev.occ_start, -3) < today ? today : d.addDays(ev.occ_start, -3) %>">Soạn bài</a><% } %><% } %>
                </p>
              </div>
            </li>
          <% } %>
        </ol>
      <% } %>
    </section>

    <section class="panel">
      <div class="panel-head"><h2>Tuần <%= d.dm(weekStart) %> – <%= d.dm(weekEnd) %></h2></div>
      <table class="table table-compact">
        <thead><tr><th>Trạng thái</th><th class="num">Số bài</th></tr></thead>
        <tbody>
          <% for (const s of Object.values(C.STATUSES)) { %>
            <tr><td><%- include('partials/chips', { kind: 'status', value: s.key }) %></td><td class="num"><%= week[s.key] || 0 %></td></tr>
          <% } %>
        </tbody>
      </table>
    </section>

    <section class="panel">
      <div class="panel-head"><h2>Email gần nhất</h2><a href="/email/campaigns">Chiến dịch</a></div>
      <% if (!campaign) { %>
        <p class="empty">Chưa gửi chiến dịch nào.</p>
      <% } else { %>
        <p><a href="/email/campaigns/<%= campaign.id %>"><strong><%= campaign.name %></strong></a></p>
        <dl class="kv">
          <dt>Đã gửi</dt><dd><%= num(campaign.stats.total) %> người, <%= d.dmy(campaign.sent_at) %></dd>
          <dt>Tỷ lệ mở</dt><dd><%= pct(Number(campaign.stats.opened), Number(campaign.stats.total)) %></dd>
          <dt>Tỷ lệ nhấp</dt><dd><%= pct(Number(campaign.stats.clicked), Number(campaign.stats.total)) %></dd>
        </dl>
      <% } %>
    </section>
  </div>
</div>
<%- include('partials/bottom') %>
