<%- include('../partials/top') %>
<%
  const editMetrics = can('post:publish') && post.status === 'published';
  const val = (v) => (v == null ? '' : v);
  const steps = ['draft', 'pending', 'scheduled', 'published'];
  const at = steps.indexOf(post.status);
  const fullText = [post.caption, post.hashtags].filter(Boolean).join('\n\n');
%>
<header class="page-head">
  <div>
    <p class="crumbs"><a href="/posts">Bài đăng</a></p>
    <h1><%= post.title %></h1>
    <p class="sub">
      <%- include('../partials/chips', { kind: 'status', value: post.status }) %>
      <% if (post.format) { %><span class="muted"><%= post.format %></span><% } %>
    </p>
  </div>
  <div class="toolbar">
    <% if (canEdit) { %><a class="btn" href="/posts/<%= post.id %>/edit">Sửa bài</a><% } %>
  </div>
</header>

<ol class="steps" aria-label="Tiến trình bài">
  <% steps.forEach((s, i) => { %>
    <li class="<%= i < at ? 'is-done' : i === at ? 'is-now' : '' %>"<%- i === at ? ' aria-current="step"' : '' %>><span><%= i + 1 %></span><%= C.STATUSES[s].label %></li>
  <% }) %>
</ol>

<% if (post.review_note) { %>
  <div class="flash <%= post.status === 'draft' ? 'flash-warn' : 'flash-info' %>">
    <strong><%= post.status === 'draft' ? 'Cần sửa' : 'Ghi chú duyệt' %><%= post.reviewer_name ? ' từ ' + post.reviewer_name : '' %>:</strong> <%= post.review_note %>
  </div>
<% } %>

<div class="detail">
  <section class="panel post-preview">
    <div class="panel-head">
      <h2>Nội dung</h2>
      <% if (fullText) { %><button class="btn btn-small" type="button" data-copy="<%= fullText %>">Sao chép để đăng</button><% } %>
    </div>
    <% if (post.media_path) { %>
      <div class="media-current media-large">
        <% if (/\.(mp4|mov|webm)$/i.test(post.media_path)) { %>
          <video src="/uploads/<%= post.media_path %>" controls preload="metadata"></video>
        <% } else { %>
          <img src="/uploads/<%= post.media_path %>" alt="Ảnh đính kèm của bài">
        <% } %>
        <a href="/uploads/<%= post.media_path %>" download>Tải file gốc</a>
      </div>
    <% } %>
    <% if (post.caption) { %><div class="caption"><%= post.caption %></div><% } else { %><p class="empty">Chưa có nội dung.</p><% } %>
    <% if (post.hashtags) { %><p class="tags"><%= post.hashtags %></p><% } %>
    <p class="muted small"><%= post.caption ? post.caption.length.toLocaleString('vi-VN') : 0 %> ký tự<%= post.caption && post.caption.length > C.GOOGLE_LIMIT ? '. Google Maps chỉ nhận ' + C.GOOGLE_LIMIT.toLocaleString('vi-VN') + ' ký tự, nhớ rút gọn khi đăng lên Google.' : '' %></p>
    <% if (post.notes) { %><div class="note"><strong>Ghi chú cho team:</strong> <%= post.notes %></div><% } %>
  </section>

  <aside class="stack">
    <section class="panel">
      <dl class="kv">
        <dt>Ngày đăng</dt><dd><%= post.scheduled_at ? d.weekday(post.scheduled_at, true) + ', ' + d.dmyhm(post.scheduled_at) : 'Chưa chọn' %></dd>
        <% if (post.event_title) { %><dt>Sự kiện</dt><dd><%= post.event_title %></dd><% } %>
        <dt>Người soạn</dt><dd><%= post.author_name || '' %></dd>
        <% if (post.reviewer_name && post.status !== 'draft') { %><dt>Người duyệt</dt><dd><%= post.reviewer_name %></dd><% } %>
        <% if (post.published_at) { %><dt>Đã đăng lúc</dt><dd><%= d.dmyhm(post.published_at) %></dd><% } %>
      </dl>
    </section>

    <% if (post.status === 'draft' && can('post:submit')) { %>
      <section class="panel">
        <form method="post" action="/posts/<%= post.id %>/submit">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-primary btn-block" type="submit"<%= post.scheduled_at ? '' : ' disabled' %>>Gửi duyệt</button>
          <% if (!post.scheduled_at) { %><p class="hint">Chọn ngày đăng trước khi gửi duyệt.</p><% } %>
        </form>
      </section>
    <% } %>

    <% if (post.status === 'pending' && can('post:approve')) { %>
      <section class="panel stack">
        <h2>Duyệt bài</h2>
        <form method="post" action="/posts/<%= post.id %>/approve" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label class="field"><span>Ghi chú (không bắt buộc)</span><textarea name="note" rows="2"></textarea></label>
          <button class="btn btn-primary btn-block" type="submit"><%- icon('check') %> Duyệt bài</button>
        </form>
        <form method="post" action="/posts/<%= post.id %>/reject" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label class="field"><span>Lý do trả về</span><textarea name="note" rows="2" required placeholder="Cần sửa gì để duyệt được?"></textarea></label>
          <button class="btn btn-block" type="submit">Trả về nháp</button>
        </form>
      </section>
    <% } %>

    <% if (can('post:create')) { %>
      <section class="panel stack">
        <h2>Dùng lại bài này</h2>
        <form method="post" action="/posts/<%= post.id %>/duplicate">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-block" type="submit">Nhân bản thành bài nháp mới</button>
        </form>
      </section>
    <% } %>

    <% if (canDelete) { %>
      <form method="post" action="/posts/<%= post.id %>/delete" data-confirm="Xoá bài “<%= post.title %>”? Không khôi phục được.">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn btn-danger-quiet" type="submit">Xoá bài</button>
      </form>
    <% } %>
  </aside>
</div>

<section class="panel panel-flush post-channels">
  <div class="panel-head pad">
    <h2>Trên các kênh</h2>
    <span class="muted small"><%= post.status === 'published' ? 'Tổng: ' + num(post.views) + ' lượt xem, ' + num(Number(post.likes) + Number(post.comments) + Number(post.shares)) + ' tương tác' : 'Cùng nội dung, đăng lên cả 4 kênh' %></span>
  </div>
  <form method="post" action="/posts/<%= post.id %>/<%= post.status === 'scheduled' ? 'publish' : 'metrics' %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <table class="table table-rows">
      <thead><tr><th>Kênh</th><th>Link bài</th><th class="num">Xem</th><th class="num">Thích</th><th class="num">Bình luận</th><th class="num">Chia sẻ</th></tr></thead>
      <tbody>
        <% for (const c of channels) { const meta = C.CHANNELS[c.channel]; %>
          <tr>
            <td><%- include('../partials/chips', { kind: 'channel', value: c.channel }) %></td>
            <% if (editMetrics || (post.status === 'scheduled' && can('post:publish'))) { %>
              <td><label class="sr-only" for="url-<%= c.channel %>">Link trên <%= meta.name %></label><input id="url-<%= c.channel %>" class="input-sm" type="url" name="url_<%= c.channel %>" value="<%= c.published_url || '' %>" placeholder="Dán link bài trên <%= meta.name %>"></td>
            <% } else { %>
              <td><% if (c.published_url) { %><a href="<%= c.published_url %>" target="_blank" rel="noopener">Mở bài</a><% } else { %><span class="muted">Chưa có link</span><% } %></td>
            <% } %>
            <% for (const m of ['views', 'likes', 'comments', 'shares']) { %>
              <td class="num">
                <% if (editMetrics) { %><label class="sr-only" for="<%= m %>-<%= c.channel %>"><%= m %> <%= meta.name %></label><input id="<%= m %>-<%= c.channel %>" class="input-num" type="number" min="0" name="<%= m %>_<%= c.channel %>" value="<%= val(c[m]) %>"><% } else { %><%= c[m] == null ? '—' : num(c[m]) %><% } %>
              </td>
            <% } %>
          </tr>
        <% } %>
      </tbody>
    </table>
    <% if (post.status === 'scheduled' && can('post:publish')) { %>
      <div class="pad post-channels-foot">
        <button class="btn btn-primary" type="submit"><%- icon('check') %> Đánh dấu đã đăng</button>
        <span class="hint">Link có thể dán sau. Với Facebook và TikTok đã kết nối, lượt thích, bình luận, chia sẻ tự cập nhật theo link.</span>
      </div>
    <% } else if (editMetrics) { %>
      <div class="pad post-channels-foot">
        <button class="btn" type="submit">Lưu link và số liệu</button>
        <span class="hint">Kênh đã kết nối tự cập nhật số liệu theo link; ô nào để trống thì bỏ qua.</span>
      </div>
    <% } %>
  </form>
</section>
<%- include('../partials/bottom') %>
