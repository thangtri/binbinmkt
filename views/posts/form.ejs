<%- include('../partials/top') %>
<%
  const isNew = !post.id;
  const date = post.scheduled_at ? post.scheduled_at.slice(0, 10) : '';
  const time = post.scheduled_at ? post.scheduled_at.slice(11, 16) : '09:00';
  const action = (isNew ? '/posts' : '/posts/' + post.id) + '?_csrf=' + csrf;
%>
<header class="page-head">
  <div>
    <p class="crumbs"><a href="/posts">Bài đăng</a><% if (!isNew) { %> / <a href="/posts/<%= post.id %>"><%= post.title %></a><% } %></p>
    <h1><%= isNew ? 'Soạn bài mới' : 'Sửa bài' %></h1>
  </div>
</header>

<% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
<% if (post.review_note && post.status === 'draft') { %>
  <div class="flash flash-warn"><strong>Góp ý khi duyệt:</strong> <%= post.review_note %></div>
<% } %>

<form method="post" action="<%= action %>" enctype="multipart/form-data" class="editor"
      data-post-form data-google-limit="<%= C.GOOGLE_LIMIT %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="editor-main panel">
    <% if (typeof aiReady !== 'undefined' && aiReady) { %>
      <details class="ai-writer" data-ai-writer data-csrf="<%= csrf %>"<%= isNew && !post.caption ? ' open' : '' %>>
        <summary><%- icon('send') %> Nhờ AI viết bài</summary>
        <div class="ai-writer-body">
          <label class="field">
            <span>Ý chính của bài</span>
            <textarea rows="3" data-ai-brief placeholder="Ví dụ: combo 2 đêm cuối tuần giảm 15%, tặng bữa sáng cho 2 người, áp dụng tới hết tháng 11"></textarea>
          </label>
          <div class="ai-writer-row">
            <label class="field field-inline"><span>Sắc thái</span>
              <select data-ai-tone>
                <option>Thân thiện, ấm áp</option>
                <option>Sang trọng, tinh tế</option>
                <option>Vui nhộn, bắt trend</option>
                <option>Ngắn gọn, đi thẳng vào ưu đãi</option>
              </select>
            </label>
            <button class="btn btn-primary" type="button" data-ai-run>Viết 3 phương án</button>
          </div>
          <p class="hint" data-ai-status aria-live="polite">AI dùng thông tin trong mục "Thông tin khách sạn" và sự kiện đã chọn. Mất khoảng 20–40 giây.</p>
          <div class="ai-options" data-ai-options></div>
        </div>
      </details>
    <% } %>
    <label class="field">
      <span>Tiêu đề nội bộ</span>
      <input type="text" name="title" value="<%= post.title %>" maxlength="200" required placeholder="Ví dụ: Ưu đãi phòng đôi cuối tuần">
      <small>Chỉ team thấy, dùng để nhận ra bài trên lịch.</small>
    </label>

    <div class="field">
      <span>Đăng lên</span>
      <p class="all-channels"><% for (const ch of Object.values(C.CHANNELS)) { %><%- include('../partials/chips', { kind: 'channel', value: ch.key }) %><% } %></p>
      <small>Cùng một nội dung cho cả 4 kênh. Sau khi đăng, dán link từng kênh để theo dõi số liệu.</small>
    </div>

    <label class="field">
      <span>Nội dung đăng</span>
      <textarea name="caption" rows="12" data-caption placeholder="Viết nội dung như khách sẽ đọc trên kênh"><%= post.caption %></textarea>
      <small class="counter" data-counter aria-live="polite"></small>
    </label>

    <label class="field">
      <span>Hashtag</span>
      <input type="text" name="hashtags" value="<%= post.hashtags %>" placeholder="#BinBinHotel #KhachSan">
    </label>

    <div class="field">
      <span>Ảnh và video</span>
      <% const list = typeof mediaList !== 'undefined' ? mediaList : []; %>
      <% if (list.length) { %>
        <input type="hidden" name="media_order" value="<%= list.map((m) => m.id).join(',') %>" data-media-order>
        <ol class="media-grid" data-media-grid>
          <% list.forEach((m, i) => { const vid = /^video\//.test(m.mime || '') || /\.(mp4|mov|webm)$/i.test(m.path); %>
            <li class="media-item" data-id="<%= m.id %>">
              <% if (vid) { %><video src="/uploads/<%= m.path %>" preload="metadata" muted></video><% } else { %><img src="/uploads/<%= m.path %>" alt="Ảnh số <%= i + 1 %>"><% } %>
              <span class="media-num" data-media-num><%= i + 1 %></span>
              <div class="media-tools">
                <button type="button" class="icon-btn" data-move="-1" aria-label="Đưa lên trước"><%- icon('left') %></button>
                <button type="button" class="icon-btn" data-move="1" aria-label="Đưa ra sau"><%- icon('right') %></button>
                <label class="check media-remove"><input type="checkbox" name="remove_<%= m.id %>" value="1"> Gỡ</label>
              </div>
            </li>
          <% }) %>
        </ol>
        <small>Ảnh số 1 là ảnh đại diện. Dùng mũi tên để đổi thứ tự đăng.</small>
      <% } %>
      <input type="file" name="media" multiple accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/quicktime,video/webm" data-media-input>
      <small>Chọn được nhiều file cùng lúc, tối đa 20 file, mỗi file 50 MB. File mới được thêm vào cuối.</small>
      <div class="media-preview" data-media-preview hidden></div>
    </div>
  </div>

  <aside class="editor-side">
    <div class="panel stack">
      <h2>Lịch đăng</h2>
      <div class="row-2">
        <label class="field"><span>Ngày</span><input type="date" name="date" value="<%= date %>"></label>
        <label class="field"><span>Giờ</span><input type="time" name="time" value="<%= time %>"></label>
      </div>
      <label class="field"><span>Định dạng</span>
        <select name="format">
          <% for (const f of C.POST_FORMATS) { %>
            <option<%= post.format === f ? ' selected' : '' %>><%= f %></option>
          <% } %>
        </select>
      </label>
      <label class="field"><span>Gắn với sự kiện</span>
        <select name="event_id">
          <option value="">Không gắn</option>
          <% for (const ev of events) { %>
            <option value="<%= ev.id %>"<%= Number(post.event_id) === Number(ev.id) ? ' selected' : '' %>><%= ev.title %><%= Number(ev.recurring) ? ' (hằng năm)' : ' (' + d.dmy(ev.start_date) + ')' %></option>
          <% } %>
        </select>
      </label>
      <label class="field"><span>Gắn với ưu đãi</span>
        <select name="offer_id">
          <option value="">Không gắn</option>
          <% for (const o of (typeof offerList !== 'undefined' ? offerList : [])) { %>
            <option value="<%= o.id %>"<%= Number(post.offer_id) === Number(o.id) ? ' selected' : '' %>><%= o.title %> (<%= o.code_prefix %>)</option>
          <% } %>
        </select>
        <small>Viết <code>{{ma}}</code> trong nội dung: khi đăng hoặc sao chép cho từng kênh, hệ thống thay bằng mã của kênh đó.</small>
      </label>
      <label class="check"><input type="checkbox" name="auto_publish" value="1"<%= Number(post.auto_publish ?? 1) ? ' checked' : '' %>> Tự đăng lên Facebook, TikTok khi đến giờ</label>
      <p class="hint">Chỉ áp dụng cho bài đã duyệt và kênh đã kết nối. Google Maps, Zalo OA vẫn đăng tay.</p>
      <label class="field"><span>Ghi chú cho team</span><textarea name="notes" rows="3" placeholder="Ai quay, cần chuẩn bị gì…"><%= post.notes %></textarea></label>
    </div>

    <div class="panel stack actions-panel">
      <% if (user.role === 'admin' && post.status !== 'published') { %>
        <button class="btn btn-primary btn-block" type="submit" name="intent" value="approve">Lưu và duyệt</button>
      <% } else if (['draft', 'pending'].includes(post.status)) { %>
        <button class="btn btn-primary btn-block" type="submit" name="intent" value="submit">Lưu và gửi duyệt</button>
      <% } %>
      <button class="btn btn-block" type="submit" name="intent" value="save"><%= post.status === 'draft' ? 'Lưu nháp' : 'Lưu thay đổi' %></button>
      <% if (post.status === 'scheduled' && user.role !== 'admin') { %><p class="hint">Bài này đã được duyệt. Sửa xong bài sẽ cần duyệt lại.</p><% } %>
      <a class="btn btn-quiet btn-block" href="<%= isNew ? '/posts' : '/posts/' + post.id %>">Huỷ</a>
    </div>
  </aside>
</form>
<%- include('../partials/bottom') %>
