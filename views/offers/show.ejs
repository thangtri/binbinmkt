<%- include('../partials/top') %>
<% const totalUsed = o.codes.reduce((s, c) => s + Number(c.used), 0); const totalRevenue = o.codes.reduce((s, c) => s + Number(c.revenue), 0); %>
<header class="page-head">
  <div>
    <p class="crumbs"><a href="/offers">Ưu đãi</a></p>
    <h1><%= o.title %></h1>
    <p class="sub"><%= d.dmy(o.start_date) %> – <%= d.dmy(o.end_date) %><span class="muted"><%= branchNames.length ? 'Tại ' + branchNames.join(', ') : 'Cả chuỗi' %></span><% if (!Number(o.active)) { %><span class="status status-draft">Đã tắt</span><% } %></p>
  </div>
  <div class="toolbar">
    <% if (can('post:create')) { %><a class="btn" href="/posts/new?offer=<%= o.id %>"><%- icon('plus') %> Soạn bài cho ưu đãi</a><% } %>
    <% if (can('offer:edit')) { %><a class="btn btn-quiet" href="/offers/<%= o.id %>/edit">Sửa</a><% } %>
  </div>
</header>

<section class="kpis">
  <div class="kpi"><span class="kpi-label">Lượt dùng mã</span><span class="kpi-value"><%= num(totalUsed) %></span><span class="kpi-note">tất cả kênh</span></div>
  <div class="kpi"><span class="kpi-label">Doanh thu ghi nhận</span><span class="kpi-value"><%= totalRevenue ? num(totalRevenue) + 'đ' : '—' %></span><span class="kpi-note">do lễ tân nhập</span></div>
  <div class="kpi"><span class="kpi-label">Bài đăng gắn ưu đãi</span><span class="kpi-value"><%= posts.length %></span><span class="kpi-note">viết {{ma}} trong bài để chèn mã kênh</span></div>
</section>

<div class="detail">
  <div class="stack">
    <section class="panel panel-flush">
      <div class="panel-head pad"><h2>Mã theo kênh</h2></div>
      <table class="table table-rows">
        <thead><tr><th>Kênh</th><th>Mã</th><th class="num">Lượt dùng</th><th class="num">Tỷ lệ</th><th class="num">Doanh thu</th></tr></thead>
        <tbody>
          <% for (const c of o.codes.slice().sort((a, b) => b.used - a.used)) { %>
            <tr>
              <td><%= channelNames[c.channel] || c.channel %></td>
              <td><code class="code-big"><%= c.code %></code></td>
              <td class="num"><%= num(c.used) %></td>
              <td class="num"><%= totalUsed ? Math.round((c.used / totalUsed) * 100) + '%' : '—' %></td>
              <td class="num"><%= Number(c.revenue) ? num(c.revenue) + 'đ' : '—' %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </section>

    <section class="panel panel-flush">
      <div class="panel-head pad"><h2>Lượt dùng gần đây</h2></div>
      <% if (!list.length) { %><p class="empty pad">Chưa có khách nào dùng mã.</p><% } else { %>
        <table class="table table-rows">
          <thead><tr><th>Ngày</th><th>Mã</th><th>Chi nhánh</th><th>Khách</th><th class="num">Đêm</th><th class="num">Doanh thu</th><% if (can('offer:redeem')) { %><th><span class="sr-only">Xoá</span></th><% } %></tr></thead>
          <tbody>
            <% for (const r of list) { %>
              <tr>
                <td class="nowrap"><%= d.dmy(r.used_on) %></td>
                <td><code><%= r.code %></code></td>
                <td><%= r.branch_name || '' %></td>
                <td><%= r.guest || '' %><% if (r.user_name) { %><small class="muted block">Ghi bởi <%= r.user_name %></small><% } %></td>
                <td class="num"><%= r.nights == null ? '' : r.nights %></td>
                <td class="num"><%= r.amount == null ? '' : num(r.amount) + 'đ' %></td>
                <% if (can('offer:redeem')) { %>
                  <td class="right"><form method="post" action="/offers/redemptions/<%= r.id %>/delete" data-confirm="Xoá lượt dùng mã này?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-small btn-quiet" type="submit">Xoá</button></form></td>
                <% } %>
              </tr>
            <% } %>
          </tbody>
        </table>
      <% } %>
    </section>
  </div>

  <aside class="stack">
    <% if (can('offer:redeem')) { %>
      <section class="panel stack">
        <h2>Ghi nhận khách dùng mã</h2>
        <%- include('_redeem', { back: 'offer' }) %>
      </section>
    <% } %>
    <section class="panel stack">
      <h2>Chi tiết</h2>
      <% if (o.summary) { %><p><strong><%= o.summary %></strong></p><% } %>
      <% if (o.details) { %><p class="caption"><%= o.details %></p><% } %>
      <% if (o.terms) { %><p class="muted small caption"><%= o.terms %></p><% } %>
      <% if (byBranch.length) { %>
        <h3>Theo chi nhánh</h3>
        <ul class="plain-list"><% for (const b of byBranch) { %><li><%= b.name || 'Không ghi chi nhánh' %>: <strong><%= num(b.used) %></strong> lượt<%= Number(b.revenue) ? ', ' + num(b.revenue) + 'đ' : '' %></li><% } %></ul>
      <% } %>
      <% if (posts.length) { %>
        <h3>Bài đăng</h3>
        <ul class="plain-list"><% for (const p of posts) { %><li><a href="/posts/<%= p.id %>"><%= p.title %></a> <%- include('../partials/chips', { kind: 'status', value: p.status }) %></li><% } %></ul>
      <% } %>
    </section>
  </aside>
</div>
<%- include('../partials/bottom') %>
