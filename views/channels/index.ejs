<%- include('../partials/top') %>
<header class="page-head">
  <div><h1>Kênh mạng xã hội</h1><p class="sub">Số liệu do team nhập từ trang quản trị của từng kênh. Hiệu quả bài tính trong 30 ngày gần nhất.</p></div>
</header>

<div class="channel-grid">
  <% for (const r of rows) { const p = r.primary; const isG = r.ch.key === 'google'; %>
    <a class="channel-card ch-<%= r.ch.key %>" href="/channels/<%= r.ch.key %>">
      <div class="cc-head">
        <span class="cc-code"><%= r.ch.code %></span>
        <div>
          <strong><%= r.ch.name %></strong>
          <small><%= (r.account && (r.account.handle || r.account.display_name)) || 'Chưa nhập tài khoản' %></small>
        </div>
      </div>
      <div class="cc-main">
        <% if (p.value == null) { %>
          <span class="cc-value muted">Chưa có số liệu</span>
        <% } else { %>
          <span class="cc-value"><%= isG ? p.value.toFixed(1) + '★' : num(p.value) %></span>
          <span class="cc-label"><%= isG ? 'từ ' + num(r.reviews.value) + ' đánh giá' : 'người theo dõi' %></span>
          <% if (p.delta) { %><span class="cc-delta <%= p.delta > 0 ? 'up' : 'down' %>"><%= p.delta > 0 ? '+' : '' %><%= isG ? p.delta.toFixed(1) : num(p.delta) %> so với <%= d.dm(p.prevOn) %></span><% } %>
        <% } %>
      </div>
      <dl class="cc-stats">
        <div><dt>Bài đã đăng</dt><dd><%= num(r.perf.posts) %></dd></div>
        <div><dt>Lượt xem bài</dt><dd><%= num(r.perf.views) %></dd></div>
        <div><dt>Tương tác</dt><dd><%= num(r.perf.interactions) %></dd></div>
        <div><dt>Sắp đăng</dt><dd><%= r.upcoming %></dd></div>
      </dl>
      <span class="cc-foot"><%= r.account && r.account.owner_name ? 'Phụ trách: ' + r.account.owner_name : 'Chưa phân công người phụ trách' %></span>
    </a>
  <% } %>
</div>
<%- include('../partials/bottom') %>
