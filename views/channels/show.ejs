<%- include('../partials/top') %>
<%
  const isGoogle = ch.key === 'google';
  const editable = can('channel:edit');
  const fmt = (m, v) => (v == null ? '—' : m.decimals ? Number(v).toFixed(m.decimals) : num(v));
  const reachLabel = isGoogle ? 'Lượt xem hồ sơ' : 'Tiếp cận';
  const engLabel = isGoogle ? 'Gọi, chỉ đường' : 'Tương tác';

  // Biểu đồ đường có trục, vẽ phía server
  let chart = null;
  if (series.length >= 2) {
    const W = 640, H = 200, L = 52, R = 16, T = 14, B = 28;
    const vals = series.map((s) => s.value);
    let min = Math.min(...vals), max = Math.max(...vals);
    if (min === max) { min -= 1; max += 1; }
    const padV = (max - min) * 0.12; min -= padV; max += padV;
    const x = (i) => L + (i * (W - L - R)) / (series.length - 1);
    const y = (v) => T + (H - T - B) * (1 - (v - min) / (max - min));
    const pts = series.map((s, i) => [x(i), y(s.value)]);
    const line = pts.map((p) => p[0].toFixed(1) + ',' + p[1].toFixed(1)).join(' ');
    const area = `M${pts[0][0].toFixed(1)},${H - B} L` + line.replace(/ /g, ' L') + ` L${pts[pts.length - 1][0].toFixed(1)},${H - B} Z`;
    const ticks = [0, 0.5, 1].map((t) => { const v = min + (max - min) * t; return { y: y(v), label: chartMetric.decimals ? v.toFixed(1) : num(Math.round(v)) }; });
    chart = { W, H, L, R, B, pts, line, area, ticks };
  }
%>
<header class="page-head">
  <div>
    <p class="crumbs"><a href="/channels">Kênh</a></p>
    <div class="ch-title ch-<%= ch.key %>">
      <span class="cc-code cc-code-lg"><%= ch.code %></span>
      <div>
        <h1><%= ch.name %></h1>
        <p class="sub">
          <% if (account.url) { %><a href="<%= account.url %>" target="_blank" rel="noopener"><%= account.handle || account.display_name || account.url %></a><% } else { %><%= account.handle || account.display_name || 'Chưa nhập tài khoản' %><% } %>
          <span class="muted"><%= account.owner_name ? 'Phụ trách: ' + account.owner_name : 'Chưa phân công người phụ trách' %></span>
        </p>
      </div>
    </div>
  </div>
  <div class="toolbar">
    <% if (can('post:create')) { %><a class="btn" href="/posts/new?channel=<%= ch.key %>"><%- icon('plus') %> Soạn bài <%= ch.name %></a><% } %>
    <% if (account.url) { %><a class="btn btn-quiet" href="<%= account.url %>" target="_blank" rel="noopener"><%- icon('link') %> Mở trang</a><% } %>
  </div>
</header>

<section class="kpis" aria-label="Số liệu mới nhất">
  <% for (const m of metrics) { %>
    <div class="kpi">
      <span class="kpi-label"><%= m.label %></span>
      <span class="kpi-value"><%= fmt(m, m.value) %><%= m.key === 'rating' && m.value != null ? '★' : '' %></span>
      <% if (m.value == null) { %>
        <span class="kpi-note">Chưa có số liệu</span>
      <% } else if (m.delta) { %>
        <span class="kpi-note <%= m.delta > 0 ? 'up' : 'down' %>"><%= m.delta > 0 ? '+' : '' %><%= fmt(m, m.delta) %> so với <%= d.dm(m.prevOn) %></span>
      <% } else { %>
        <span class="kpi-note">Ghi ngày <%= d.dm(m.on) %></span>
      <% } %>
    </div>
  <% } %>
</section>

<div class="detail">
  <div class="stack">
    <section class="panel">
      <div class="panel-head">
        <h2><%= chartMetric.label %> theo thời gian</h2>
        <% if (series.length) { %><span class="muted small"><%= series.length %> lần ghi</span><% } %>
      </div>
      <% if (chart) { %>
        <svg class="chart" viewBox="0 0 <%= chart.W %> <%= chart.H %>" role="img"
             aria-label="<%= chartMetric.label %> từ <%= d.dmy(series[0].day) %> đến <%= d.dmy(series[series.length - 1].day) %>, gần nhất <%= fmt(chartMetric, series[series.length - 1].value) %>">
          <% for (const t of chart.ticks) { %>
            <line x1="<%= chart.L %>" x2="<%= chart.W - chart.R %>" y1="<%= t.y.toFixed(1) %>" y2="<%= t.y.toFixed(1) %>" class="grid"/>
            <text x="<%= chart.L - 8 %>" y="<%= (t.y + 4).toFixed(1) %>" text-anchor="end" class="tick"><%= t.label %></text>
          <% } %>
          <path d="<%= chart.area %>" class="area"/>
          <polyline points="<%= chart.line %>" class="line"/>
          <% chart.pts.forEach((p, i) => { %>
            <circle cx="<%= p[0].toFixed(1) %>" cy="<%= p[1].toFixed(1) %>" r="<%= i === chart.pts.length - 1 ? 4.5 : 3 %>" class="dot<%= i === chart.pts.length - 1 ? ' dot-last' : '' %>"><title><%= d.dmy(series[i].day) %>: <%= fmt(chartMetric, series[i].value) %></title></circle>
          <% }) %>
          <text x="<%= chart.L %>" y="<%= chart.H - 8 %>" class="tick"><%= d.dmy(series[0].day) %></text>
          <text x="<%= chart.W - chart.R %>" y="<%= chart.H - 8 %>" text-anchor="end" class="tick"><%= d.dmy(series[series.length - 1].day) %></text>
        </svg>
      <% } else { %>
        <div class="empty-chart">
          <p><strong>Chưa đủ số liệu để vẽ biểu đồ.</strong></p>
          <p class="muted">Ghi số liệu ít nhất 2 lần (ví dụ mỗi thứ Hai) để thấy xu hướng tăng giảm.</p>
        </div>
      <% } %>
    </section>

    <section class="panel">
      <div class="panel-head"><h2>Hiệu quả bài đăng, 30 ngày qua</h2><a href="/posts?channel=<%= ch.key %>&status=published">Xem bài đã đăng</a></div>
      <dl class="perf">
        <div><dt>Bài đã đăng</dt><dd><%= num(perf.posts) %></dd></div>
        <div><dt>Lượt xem</dt><dd><%= num(perf.views) %></dd></div>
        <div><dt>Thích</dt><dd><%= num(perf.likes) %></dd></div>
        <div><dt>Bình luận</dt><dd><%= num(perf.comments) %></dd></div>
        <div><dt>Chia sẻ</dt><dd><%= num(perf.shares) %></dd></div>
        <div><dt>Xem trung bình mỗi bài</dt><dd><%= perf.posts ? num(Math.round(perf.views / perf.posts)) : '—' %></dd></div>
      </dl>
      <% if (posts.length) { %>
        <table class="table table-compact">
          <thead><tr><th>Bài gần đây</th><th class="num">Xem</th><th class="num">Tương tác</th></tr></thead>
          <tbody>
            <% for (const p of posts) { %>
              <tr>
                <td><a href="/posts/<%= p.id %>"><%= p.title %></a><small class="muted block"><%= d.dmy(p.published_at) %></small></td>
                <td class="num"><%= num(p.views) %></td>
                <td class="num"><%= num(Number(p.likes) + Number(p.comments) + Number(p.shares)) %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      <% } else { %>
        <p class="empty">Chưa có bài nào được đánh dấu đã đăng trên <%= ch.name %>. Sau khi đăng, mở bài và bấm "Đánh dấu đã đăng" để số liệu hiện ở đây.</p>
      <% } %>
    </section>

    <section class="panel panel-flush">
      <div class="panel-head pad">
        <h2>Lịch sử số liệu</h2>
        <% if (editable) { %><a href="#ghi-so-lieu">Ghi số liệu mới</a><% } %>
      </div>
      <% if (!stats.length) { %>
        <p class="empty pad">Chưa có số liệu nào.</p>
      <% } else { %>
        <table class="table table-rows">
          <thead><tr><th>Ngày</th>
            <% if (isGoogle) { %><th class="num">Điểm</th><th class="num">Đánh giá</th><% } else { %><th class="num">Theo dõi</th><% } %>
            <th class="num"><%= reachLabel %></th><th class="num"><%= engLabel %></th><th>Ghi chú</th><% if (editable) { %><th><span class="sr-only">Xoá</span></th><% } %></tr></thead>
          <tbody>
          <% for (const s of stats.slice(0, 20)) { %>
            <tr>
              <td class="nowrap"><%= d.dmy(s.recorded_on) %></td>
              <% if (isGoogle) { %>
                <td class="num"><%= s.rating != null ? Number(s.rating).toFixed(1) + '★' : '—' %></td>
                <td class="num"><%= s.reviews != null ? num(s.reviews) : '—' %></td>
              <% } else { %>
                <td class="num"><%= s.followers != null ? num(s.followers) : '—' %></td>
              <% } %>
              <td class="num"><%= s.reach != null ? num(s.reach) : '—' %></td>
              <td class="num"><%= s.engagement != null ? num(s.engagement) : '—' %></td>
              <td><%= s.note || '' %><% if (s.user_name) { %><small class="muted block">Nhập bởi <%= s.user_name %></small><% } %></td>
              <% if (editable) { %>
                <td class="right">
                  <form method="post" action="/channels/<%= ch.key %>/stats/<%= s.id %>/delete" data-confirm="Xoá dòng số liệu ngày <%= d.dmy(s.recorded_on) %>?">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <button class="btn btn-small btn-quiet" type="submit">Xoá</button>
                  </form>
                </td>
              <% } %>
            </tr>
          <% } %>
          </tbody>
        </table>
      <% } %>
    </section>
  </div>

  <aside class="stack">
    <section class="panel stack">
      <h2>Sắp đăng</h2>
      <% if (!upcoming.length) { %>
        <p class="empty">Chưa có bài nào lên lịch cho <%= ch.name %>.</p>
      <% } else { %>
        <ul class="plain-list">
          <% for (const p of upcoming) { %>
            <li class="up-row">
              <span class="up-when"><strong><%= d.dm(p.scheduled_at) %></strong><small><%= d.hm(p.scheduled_at) %></small></span>
              <span><a href="/posts/<%= p.id %>"><%= p.title %></a><br><%- include('../partials/chips', { kind: 'status', value: p.status }) %></span>
            </li>
          <% } %>
        </ul>
      <% } %>
      <p class="hint"><%= ch.tips %></p>
    </section>

    <% if (editable) { %>
      <section class="panel stack" id="ghi-so-lieu">
        <h2>Ghi số liệu mới</h2>
        <p class="hint">Lấy số trong <%= isGoogle ? 'Google Business Profile, mục Hiệu suất' : ch.key === 'zalo' ? 'trang quản trị Zalo OA' : ch.key === 'tiktok' ? 'TikTok Studio, mục Phân tích' : 'Meta Business Suite, mục Thông tin chi tiết' %>. Ô nào chưa có số thì để trống.</p>
        <form method="post" action="/channels/<%= ch.key %>/stats" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label class="field"><span>Ngày</span><input type="date" name="recorded_on" value="<%= today %>" required></label>
          <div class="row-2">
            <% if (isGoogle) { %>
              <label class="field"><span>Điểm đánh giá</span><input type="number" min="0" max="5" step="0.1" name="rating" placeholder="4,6"></label>
              <label class="field"><span>Số đánh giá</span><input type="number" min="0" name="reviews" inputmode="numeric"></label>
            <% } else { %>
              <label class="field field-wide"><span>Người theo dõi</span><input type="number" min="0" name="followers" inputmode="numeric"></label>
            <% } %>
            <label class="field"><span><%= reachLabel %></span><input type="number" min="0" name="reach" inputmode="numeric"></label>
            <label class="field"><span><%= engLabel %></span><input type="number" min="0" name="engagement" inputmode="numeric"></label>
          </div>
          <label class="field"><span>Ghi chú</span><input type="text" name="note" maxlength="255" placeholder="Ví dụ: chạy quảng cáo 500.000đ"></label>
          <button class="btn btn-primary" type="submit">Lưu số liệu</button>
        </form>
      </section>
    <% } %>

    <section class="panel stack">
      <h2>Thông tin tài khoản</h2>
      <% if (editable) { %>
        <form method="post" action="/channels/<%= ch.key %>/account" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label class="field"><span>Tên hiển thị</span><input type="text" name="display_name" value="<%= account.display_name || '' %>"></label>
          <label class="field"><span><%= isGoogle ? 'Tên trên Maps' : 'Tên tài khoản' %></span><input type="text" name="handle" value="<%= account.handle || '' %>" placeholder="<%= ch.key === 'tiktok' ? '@binbinhotel' : '' %>"></label>
          <label class="field"><span>Đường dẫn</span><input type="url" name="url" value="<%= account.url || '' %>" placeholder="https://"></label>
          <label class="field"><span>Người phụ trách</span>
            <select name="owner_id"><option value="">Chưa phân công</option>
              <% for (const u of users) { %><option value="<%= u.id %>"<%= Number(account.owner_id) === Number(u.id) ? ' selected' : '' %>><%= u.name %></option><% } %>
            </select>
          </label>
          <label class="field"><span>Ghi chú</span><textarea name="notes" rows="3" placeholder="Giờ đăng hiệu quả, quy định riêng của kênh…"><%= account.notes || '' %></textarea>
            <small>Không lưu mật khẩu ở đây.</small></label>
          <button class="btn" type="submit">Lưu thông tin</button>
        </form>
      <% } else { %>
        <dl class="kv">
          <dt>Tài khoản</dt><dd><%= account.handle || account.display_name || '—' %></dd>
          <% if (account.notes) { %><dt>Ghi chú</dt><dd><%= account.notes %></dd><% } %>
        </dl>
      <% } %>
    </section>
  </aside>
</div>
<%- include('../partials/bottom') %>
