<%- include('../partials/top') %>
<%
  const isGoogle = ch.key === 'google';
  const editable = can('channel:edit');
  const fmt = (m, v) => (v == null ? '—' : m.decimals ? Number(v).toFixed(m.decimals) : num(v));
  const showReach = !isGoogle && ch.key !== 'zalo';
  const sourceLabel = { auto: 'Tự động', manual: 'Nhập tay' };
  const connectHelp = {
    facebook: 'Đăng nhập bằng tài khoản Facebook đang quản trị Page của khách sạn. Hệ thống chỉ xin quyền đọc số liệu, không đăng bài thay bạn.',
    tiktok: 'Đăng nhập tài khoản TikTok của khách sạn và cho phép đọc thông tin hồ sơ, danh sách video.',
    zalo: 'Đăng nhập bằng tài khoản Zalo đang là quản trị viên của OA và cấp quyền cho ứng dụng.',
  };

  // Biểu đồ đường có trục, vẽ phía server
  let chart = null;
  if (series.length >= 2) {
    const W = 640, H = 200, L = 52, R = 16, T = 14, B = 28;
    const vals = series.map((s) => s.value);
    let min = Math.min(...vals), max = Math.max(...vals);
    if (min === max) { min -= 1; max += 1; }
    const padV = (max - min) * 0.12; min -= padV; max += padV;
    const x = (i) => L + (i * (W - L - R)) / (series.length - 1);
    const y = (v) => T + (H - T - B) * (1 - (v - min) / (max - min));
    const pts = series.map((s, i) => [x(i), y(s.value)]);
    const line = pts.map((p) => p[0].toFixed(1) + ',' + p[1].toFixed(1)).join(' ');
    const area = `M${pts[0][0].toFixed(1)},${H - B} L` + line.replace(/ /g, ' L') + ` L${pts[pts.length - 1][0].toFixed(1)},${H - B} Z`;
    const ticks = [0, 0.5, 1].map((t) => { const v = min + (max - min) * t; return { y: y(v), label: chartMetric.decimals ? v.toFixed(1) : num(Math.round(v)) }; });
    chart = { W, H, L, R, B, pts, line, area, ticks };
  }
%>
<header class="page-head">
  <div>
    <p class="crumbs"><a href="/channels">Kênh</a></p>
    <div class="ch-title ch-<%= ch.key %>">
      <span class="cc-code cc-code-lg"><%= ch.code %></span>
      <div>
        <h1><%= ch.name %></h1>
        <p class="sub">
          <% if (account.url) { %><a href="<%= account.url %>" target="_blank" rel="noopener"><%= (extra.profile && extra.profile.name) || account.handle || account.display_name || 'Mở trang' %></a><% } else { %><%= account.handle || account.display_name || 'Chưa kết nối tài khoản' %><% } %>
          <span class="muted"><%= account.owner_name ? 'Phụ trách: ' + account.owner_name : 'Chưa phân công người phụ trách' %></span>
        </p>
      </div>
    </div>
  </div>
  <div class="toolbar">
    <% if (can('post:create')) { %><a class="btn" href="/posts/new?channel=<%= ch.key %>"><%- icon('plus') %> Soạn bài <%= ch.name %></a><% } %>
  </div>
</header>

<%# ---------- Kết nối ---------- %>
<section class="connect panel is-<%= conn.connected ? (conn.status === 'ok' ? 'ok' : 'warn') : 'off' %>">
  <div class="connect-state">
    <span class="connect-dot" aria-hidden="true"></span>
    <div>
      <% if (!conn.connected) { %>
        <strong>Chưa kết nối</strong>
        <p class="muted small">Kết nối một lần, số liệu sẽ tự cập nhật mỗi 12 giờ.</p>
      <% } else if (conn.status === 'ok') { %>
        <strong>Đang tự động cập nhật</strong>
        <p class="muted small">Lần gần nhất: <%= d.dmyhm(conn.lastSyncedAt) %>. Lần tới: khoảng 12 giờ sau.</p>
      <% } else if (conn.status === 'reconnect') { %>
        <strong>Cần kết nối lại</strong>
        <p class="muted small"><%= conn.error %></p>
      <% } else { %>
        <strong>Lần cập nhật gần nhất bị lỗi</strong>
        <p class="muted small"><%= conn.error || 'Chưa cập nhật lần nào.' %></p>
      <% } %>
    </div>
  </div>

  <% if (editable) { %>
    <div class="connect-actions">
      <% if (!conn.configured) { %>
        <p class="hint">Quản trị viên cần thêm <code><%= conn.missingEnv.join('</code>, <code>') %></code> vào biến môi trường trên Hostinger. Xem mục "Kết nối kênh" trong DEPLOY.md.</p>
      <% } else if (isGoogle) { %>
        <form method="post" action="/channels/google/link" class="inline-form connect-link">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label class="sr-only" for="maps-link">Link Google Maps của khách sạn</label>
          <input id="maps-link" type="url" name="link" required value="<%= account.url || '' %>" placeholder="Dán link Google Maps, ví dụ https://maps.app.goo.gl/…">
          <button class="btn btn-primary" type="submit"><%= conn.connected ? 'Đổi link' : 'Lưu và lấy số liệu' %></button>
        </form>
      <% } else if (!conn.connected || conn.status === 'reconnect') { %>
        <form method="post" action="/channels/<%= ch.key %>/connect">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-primary" type="submit"><%- icon('link') %> <%= conn.connected ? 'Kết nối lại' : 'Kết nối ' + ch.name %></button>
        </form>
      <% } %>
      <% if (conn.connected && conn.configured) { %>
        <form method="post" action="/channels/<%= ch.key %>/sync">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn" type="submit">Cập nhật ngay</button>
        </form>
        <form method="post" action="/channels/<%= ch.key %>/disconnect" data-confirm="Ngắt kết nối <%= ch.name %>? Số liệu đã lấy vẫn được giữ.">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-quiet" type="submit">Ngắt kết nối</button>
        </form>
      <% } %>
    </div>
    <% if (conn.configured && !conn.connected) { %>
      <p class="hint connect-help"><%= isGoogle ? 'Mở Google Maps, tìm Bin Bin Hotel, bấm Chia sẻ rồi Sao chép đường liên kết. Hệ thống tự lấy điểm, số đánh giá và đánh giá mới nhất.' : connectHelp[ch.key] %></p>
    <% } %>
    <% if (isGoogle && conn.connected && extra.profile && extra.profile.address) { %>
      <p class="hint connect-help">Địa điểm đang theo dõi: <strong><%= extra.profile.name %></strong>, <%= extra.profile.address %>. Nếu sai địa điểm, dán lại link khác.</p>
    <% } %>
  <% } %>
</section>

<section class="kpis" aria-label="Số liệu mới nhất">
  <% for (const m of metrics) { %>
    <div class="kpi">
      <span class="kpi-label"><%= m.label %></span>
      <span class="kpi-value"><%= fmt(m, m.value) %><%= m.key === 'rating' && m.value != null ? '★' : '' %></span>
      <% if (m.value == null) { %>
        <span class="kpi-note">Chưa có số liệu</span>
      <% } else if (m.delta) { %>
        <span class="kpi-note <%= m.delta > 0 ? 'up' : 'down' %>"><%= m.delta > 0 ? '+' : '' %><%= fmt(m, m.delta) %> so với <%= d.dm(m.prevOn) %></span>
      <% } else { %>
        <span class="kpi-note">Cập nhật <%= d.dm(m.on) %></span>
      <% } %>
    </div>
  <% } %>
  <% if (ch.key === 'tiktok' && extra.profile && extra.profile.likes != null) { %>
    <div class="kpi"><span class="kpi-label">Tổng lượt thích</span><span class="kpi-value"><%= num(extra.profile.likes) %></span><span class="kpi-note"><%= num(extra.profile.videos) %> video</span></div>
  <% } %>
</section>

<div class="detail">
  <div class="stack">
    <%# ---------- Phân tích AI ---------- %>
    <section class="panel ai-panel" id="ai">
      <div class="panel-head">
        <h2>Phân tích của AI</h2>
        <% if (insight) { %><span class="muted small"><%= d.dmyhm(insight.created_at) %></span><% } %>
      </div>
      <% if (insight) { %>
        <p class="ai-summary"><%= insight.summary %></p>
        <div class="ai-cols">
          <% if (insight.highlights.length) { %><div><h3>Điểm tốt</h3><ul><% for (const x of insight.highlights) { %><li><%= x %></li><% } %></ul></div><% } %>
          <% if (insight.concerns.length) { %><div><h3>Cần chú ý</h3><ul><% for (const x of insight.concerns) { %><li><%= x %></li><% } %></ul></div><% } %>
        </div>
        <% if (insight.recommendations.length) { %>
          <div class="ai-reco"><h3>Nên làm tuần này</h3><ul><% for (const x of insight.recommendations) { %><li><%= x %></li><% } %></ul></div>
        <% } %>
      <% } else if (!aiConfigured) { %>
        <p class="empty">Chưa bật phân tích AI. Quản trị viên cần thêm <code>ANTHROPIC_API_KEY</code> vào biến môi trường.</p>
      <% } else { %>
        <p class="empty">AI tự phân tích mỗi tuần khi kênh đã có số liệu. Bạn cũng có thể chạy ngay.</p>
      <% } %>
      <% if (aiConfigured && editable) { %>
        <form method="post" action="/channels/<%= ch.key %>/analyze" class="ai-run">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-small" type="submit" data-busy="AI đang phân tích…"><%= insight ? 'Phân tích lại' : 'Phân tích ngay' %></button>
          <span class="hint">Mất khoảng 20–60 giây.</span>
        </form>
      <% } %>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2><%= chartMetric.label %> theo thời gian</h2>
        <% if (series.length) { %><span class="muted small"><%= series.length %> lần ghi</span><% } %>
      </div>
      <% if (chart) { %>
        <svg class="chart" viewBox="0 0 <%= chart.W %> <%= chart.H %>" role="img"
             aria-label="<%= chartMetric.label %> từ <%= d.dmy(series[0].day) %> đến <%= d.dmy(series[series.length - 1].day) %>, gần nhất <%= fmt(chartMetric, series[series.length - 1].value) %>">
          <% for (const t of chart.ticks) { %>
            <line x1="<%= chart.L %>" x2="<%= chart.W - chart.R %>" y1="<%= t.y.toFixed(1) %>" y2="<%= t.y.toFixed(1) %>" class="grid"/>
            <text x="<%= chart.L - 8 %>" y="<%= (t.y + 4).toFixed(1) %>" text-anchor="end" class="tick"><%= t.label %></text>
          <% } %>
          <path d="<%= chart.area %>" class="area"/>
          <polyline points="<%= chart.line %>" class="line"/>
          <% chart.pts.forEach((p, i) => { %>
            <circle cx="<%= p[0].toFixed(1) %>" cy="<%= p[1].toFixed(1) %>" r="<%= i === chart.pts.length - 1 ? 4.5 : 3 %>" class="dot<%= i === chart.pts.length - 1 ? ' dot-last' : '' %>"><title><%= d.dmy(series[i].day) %>: <%= fmt(chartMetric, series[i].value) %></title></circle>
          <% }) %>
          <text x="<%= chart.L %>" y="<%= chart.H - 8 %>" class="tick"><%= d.dmy(series[0].day) %></text>
          <text x="<%= chart.W - chart.R %>" y="<%= chart.H - 8 %>" text-anchor="end" class="tick"><%= d.dmy(series[series.length - 1].day) %></text>
        </svg>
      <% } else { %>
        <div class="empty-chart">
          <p><strong>Chưa đủ số liệu để vẽ biểu đồ.</strong></p>
          <p class="muted"><%= conn.connected ? 'Hệ thống ghi số liệu mỗi ngày; biểu đồ hiện từ ngày thứ hai.' : 'Kết nối kênh để hệ thống tự ghi số liệu mỗi ngày.' %></p>
        </div>
      <% } %>
    </section>

    <% if (isGoogle && extra.recentReviews && extra.recentReviews.length) { %>
      <section class="panel">
        <div class="panel-head"><h2>Đánh giá gần đây trên Google</h2><% if (extra.profile && extra.profile.url) { %><a href="<%= extra.profile.url %>" target="_blank" rel="noopener">Trả lời trên Google</a><% } %></div>
        <ul class="reviews">
          <% for (const r of extra.recentReviews) { %>
            <li>
              <div class="review-head"><strong><%= r.author %></strong><span class="stars" aria-label="<%= r.rating %> sao"><%= '★'.repeat(Math.round(r.rating || 0)) %><span class="stars-off"><%= '★'.repeat(5 - Math.round(r.rating || 0)) %></span></span><span class="muted small"><%= r.when %></span></div>
              <% if (r.text) { %><p><%= r.text %></p><% } %>
            </li>
          <% } %>
        </ul>
        <p class="hint">Google chỉ cung cấp tối đa 5 đánh giá tiêu biểu qua API.</p>
      </section>
    <% } %>

    <% if (!isGoogle) { %>
    <section class="panel">
      <div class="panel-head"><h2>Hiệu quả bài đăng, 30 ngày qua</h2><a href="/posts?channel=<%= ch.key %>&status=published">Xem bài đã đăng</a></div>
      <dl class="perf">
        <div><dt>Bài đã đăng</dt><dd><%= num(perf.posts) %></dd></div>
        <div><dt>Lượt xem</dt><dd><%= num(perf.views) %></dd></div>
        <div><dt>Thích</dt><dd><%= num(perf.likes) %></dd></div>
        <div><dt>Bình luận</dt><dd><%= num(perf.comments) %></dd></div>
        <div><dt>Chia sẻ</dt><dd><%= num(perf.shares) %></dd></div>
        <div><dt>Xem trung bình mỗi bài</dt><dd><%= perf.posts ? num(Math.round(perf.views / perf.posts)) : '—' %></dd></div>
      </dl>
      <% const apiPosts = (extra.posts || []).slice(0, 8); %>
      <% if (apiPosts.length) { %>
        <table class="table table-compact">
          <thead><tr><th>Bài mới nhất trên <%= ch.name %></th><% if (ch.key === 'tiktok') { %><th class="num">Xem</th><% } %><th class="num">Thích</th><th class="num">Bình luận</th><th class="num">Chia sẻ</th></tr></thead>
          <tbody>
            <% for (const p of apiPosts) { %>
              <tr>
                <td><% if (p.url) { %><a href="<%= p.url %>" target="_blank" rel="noopener"><%= p.title || 'Không có tiêu đề' %></a><% } else { %><%= p.title %><% } %><% if (p.createdAt) { %><small class="muted block"><%= d.dmy(String(p.createdAt).slice(0, 10)) %></small><% } %></td>
                <% if (ch.key === 'tiktok') { %><td class="num"><%= num(p.views) %></td><% } %>
                <td class="num"><%= num(p.likes) %></td>
                <td class="num"><%= num(p.comments) %></td>
                <td class="num"><%= num(p.shares) %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
        <p class="hint">Bài trong lịch có link trùng với bài trên kênh sẽ được cập nhật lượt thích, bình luận, chia sẻ tự động.</p>
      <% } else if (posts.length) { %>
        <table class="table table-compact">
          <thead><tr><th>Bài gần đây</th><th class="num">Xem</th><th class="num">Tương tác</th></tr></thead>
          <tbody>
            <% for (const p of posts) { %>
              <tr>
                <td><a href="/posts/<%= p.id %>"><%= p.title %></a><small class="muted block"><%= d.dmy(p.published_at) %></small></td>
                <td class="num"><%= num(p.views) %></td>
                <td class="num"><%= num(Number(p.likes) + Number(p.comments) + Number(p.shares)) %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      <% } else { %>
        <p class="empty">Chưa có bài nào. <%= conn.connected ? 'Bài mới trên kênh sẽ hiện ở đây sau lần cập nhật tới.' : 'Kết nối kênh để thấy bài và tương tác.' %></p>
      <% } %>
    </section>
    <% } %>

    <section class="panel panel-flush">
      <div class="panel-head pad"><h2>Lịch sử số liệu</h2></div>
      <% if (!stats.length) { %>
        <p class="empty pad">Chưa có số liệu nào.</p>
      <% } else { %>
        <table class="table table-rows">
          <thead><tr><th>Ngày</th>
            <% if (isGoogle) { %><th class="num">Điểm</th><th class="num">Đánh giá</th><% } else { %><th class="num">Theo dõi</th><% } %>
            <% if (showReach) { %><th class="num">Tiếp cận</th><th class="num">Tương tác</th><% } %>
            <th>Nguồn</th><% if (editable) { %><th><span class="sr-only">Xoá</span></th><% } %></tr></thead>
          <tbody>
          <% for (const s of stats.slice(0, 20)) { %>
            <tr>
              <td class="nowrap"><%= d.dmy(s.recorded_on) %></td>
              <% if (isGoogle) { %>
                <td class="num"><%= s.rating != null ? Number(s.rating).toFixed(1) + '★' : '—' %></td>
                <td class="num"><%= s.reviews != null ? num(s.reviews) : '—' %></td>
              <% } else { %>
                <td class="num"><%= s.followers != null ? num(s.followers) : '—' %></td>
              <% } %>
              <% if (showReach) { %>
                <td class="num"><%= s.reach != null ? num(s.reach) : '—' %></td>
                <td class="num"><%= s.engagement != null ? num(s.engagement) : '—' %></td>
              <% } %>
              <td><%= sourceLabel[s.source] || 'Nhập tay' %><% if (s.note) { %><small class="muted block"><%= s.note %></small><% } %></td>
              <% if (editable) { %>
                <td class="right">
                  <form method="post" action="/channels/<%= ch.key %>/stats/<%= s.id %>/delete" data-confirm="Xoá dòng số liệu ngày <%= d.dmy(s.recorded_on) %>?">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <button class="btn btn-small btn-quiet" type="submit">Xoá</button>
                  </form>
                </td>
              <% } %>
            </tr>
          <% } %>
          </tbody>
        </table>
      <% } %>
    </section>
  </div>

  <aside class="stack">
    <section class="panel stack">
      <h2>Sắp đăng</h2>
      <% if (!upcoming.length) { %>
        <p class="empty">Chưa có bài nào lên lịch cho <%= ch.name %>.</p>
      <% } else { %>
        <ul class="plain-list">
          <% for (const p of upcoming) { %>
            <li class="up-row">
              <span class="up-when"><strong><%= d.dm(p.scheduled_at) %></strong><small><%= d.hm(p.scheduled_at) %></small></span>
              <span><a href="/posts/<%= p.id %>"><%= p.title %></a><br><%- include('../partials/chips', { kind: 'status', value: p.status }) %></span>
            </li>
          <% } %>
        </ul>
      <% } %>
      <p class="hint"><%= ch.tips %></p>
    </section>

    <section class="panel stack">
      <h2>Thông tin tài khoản</h2>
      <% if (editable) { %>
        <form method="post" action="/channels/<%= ch.key %>/account" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label class="field"><span>Tên hiển thị</span><input type="text" name="display_name" value="<%= account.display_name || '' %>"></label>
          <% if (!isGoogle) { %>
            <label class="field"><span>Tên tài khoản</span><input type="text" name="handle" value="<%= account.handle || '' %>" placeholder="<%= ch.key === 'tiktok' ? '@binbinhotel' : '' %>"></label>
            <label class="field"><span>Đường dẫn</span><input type="url" name="url" value="<%= account.url || '' %>" placeholder="https://"></label>
          <% } else { %>
            <input type="hidden" name="url" value="<%= account.url || '' %>">
          <% } %>
          <label class="field"><span>Người phụ trách</span>
            <select name="owner_id"><option value="">Chưa phân công</option>
              <% for (const u of users) { %><option value="<%= u.id %>"<%= Number(account.owner_id) === Number(u.id) ? ' selected' : '' %>><%= u.name %></option><% } %>
            </select>
          </label>
          <label class="field"><span>Ghi chú</span><textarea name="notes" rows="3" placeholder="Giờ đăng hiệu quả, quy định riêng của kênh…"><%= account.notes || '' %></textarea>
            <small>Không lưu mật khẩu ở đây.</small></label>
          <button class="btn" type="submit">Lưu thông tin</button>
        </form>
      <% } else { %>
        <dl class="kv">
          <dt>Tài khoản</dt><dd><%= account.handle || account.display_name || '—' %></dd>
          <% if (account.notes) { %><dt>Ghi chú</dt><dd><%= account.notes %></dd><% } %>
        </dl>
      <% } %>
    </section>

    <% if (editable) { %>
      <details class="panel manual">
        <summary>Nhập số liệu thủ công</summary>
        <p class="hint">Chỉ dùng khi kênh chưa kết nối được hoặc cần bổ sung số liệu cũ. Số liệu tự động vẫn được ghi riêng.</p>
        <form method="post" action="/channels/<%= ch.key %>/stats" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label class="field"><span>Ngày</span><input type="date" name="recorded_on" value="<%= today %>" required></label>
          <div class="row-2">
            <% if (isGoogle) { %>
              <label class="field"><span>Điểm đánh giá</span><input type="number" min="0" max="5" step="0.1" name="rating"></label>
              <label class="field"><span>Số đánh giá</span><input type="number" min="0" name="reviews" inputmode="numeric"></label>
            <% } else { %>
              <label class="field field-wide"><span>Người theo dõi</span><input type="number" min="0" name="followers" inputmode="numeric"></label>
              <% if (showReach) { %>
                <label class="field"><span>Tiếp cận</span><input type="number" min="0" name="reach" inputmode="numeric"></label>
                <label class="field"><span>Tương tác</span><input type="number" min="0" name="engagement" inputmode="numeric"></label>
              <% } %>
            <% } %>
          </div>
          <label class="field"><span>Ghi chú</span><input type="text" name="note" maxlength="255"></label>
          <button class="btn" type="submit">Lưu số liệu</button>
        </form>
      </details>
    <% } %>
  </aside>
</div>
