<%- include('../partials/top') %>
<%
  const editable = can('channel:edit');
  const delta = (b, key, dec) => {
    if (!b.latest || !b.previous || b.latest[key] == null || b.previous[key] == null) return null;
    const f = 10 ** (dec || 0);
    return Math.round((Number(b.latest[key]) - Number(b.previous[key])) * f) / f;
  };
  const deltaText = (v, dec) => (v ? `<small class="block ${v > 0 ? 'up' : 'down'}">${v > 0 ? '+' : ''}${dec ? v.toFixed(dec) : num(v)}</small>` : '');
%>
<header class="page-head">
  <div>
    <p class="crumbs"><a href="/channels">Kênh</a></p>
    <div class="ch-title ch-google">
      <span class="cc-code cc-code-lg"><%= ch.code %></span>
      <div>
        <h1>Google Maps</h1>
        <p class="sub">Mỗi chi nhánh một địa điểm riêng. Số liệu tự cập nhật mỗi 12 giờ.
          <span class="muted"><%= account.owner_name ? 'Phụ trách: ' + account.owner_name : '' %></span></p>
      </div>
    </div>
  </div>
  <% if (editable && conn.configured && chain.tracked) { %>
    <form method="post" action="/channels/google/sync">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn" type="submit" data-busy="Đang cập nhật…">Cập nhật ngay</button>
    </form>
  <% } %>
</header>

<% if (!conn.configured) { %>
  <section class="connect panel is-off">
    <div class="setup-steps connect-help">
      <p><strong>Máy chủ chưa có khoá Google Places API.</strong> Quản trị viên thêm <code>GOOGLE_PLACES_API_KEY</code> vào biến môi trường (xem mục 5 trong DEPLOY.md), khởi động lại website rồi dán link Google Maps cho từng chi nhánh bên dưới.</p>
    </div>
  </section>
<% } else if (conn.error) { %>
  <div class="flash flash-warn"><strong>Lần cập nhật gần nhất có lỗi:</strong> <%= conn.error %></div>
<% } %>

<section class="kpis" aria-label="Tổng cả chuỗi">
  <div class="kpi"><span class="kpi-label">Điểm trung bình cả chuỗi</span><span class="kpi-value"><%= chain.rating != null ? chain.rating.toFixed(1) + '★' : '—' %></span><span class="kpi-note">tính theo số đánh giá từng chi nhánh</span></div>
  <div class="kpi"><span class="kpi-label">Tổng số đánh giá</span><span class="kpi-value"><%= num(chain.reviews) %></span><span class="kpi-note">cộng tất cả chi nhánh</span></div>
  <div class="kpi"><span class="kpi-label">Chi nhánh đang theo dõi</span><span class="kpi-value"><%= chain.tracked %>/<%= chain.branches %></span><span class="kpi-note"><%= chain.tracked < chain.branches ? 'còn chi nhánh chưa dán link' : 'đã đủ' %></span></div>
</section>

<section class="panel panel-flush">
  <div class="panel-head pad">
    <h2>Các chi nhánh</h2>
    <% if (user.role === 'admin') { %><a href="/settings#chi-nhanh">Thêm, sửa chi nhánh</a><% } %>
  </div>
  <% if (!snap.length) { %>
    <p class="empty pad">Chưa có chi nhánh nào. Quản trị viên thêm chi nhánh trong mục Thông tin khách sạn.</p>
  <% } else { %>
    <table class="table table-rows branch-table">
      <thead><tr><th>Chi nhánh</th><th class="num">Điểm</th><th class="num">Đánh giá</th><th>Cập nhật</th><th>Link Google Maps</th></tr></thead>
      <tbody>
        <% for (const b of snap) { const dr = delta(b, 'rating', 1); const dn = delta(b, 'reviews'); %>
          <tr>
            <td>
              <a class="row-title" href="/channels/google/branch/<%= b.id %>"><%= b.name %></a>
              <% if (b.address) { %><small class="muted block"><%= b.address %></small><% } %>
            </td>
            <td class="num"><%= b.latest && b.latest.rating != null ? Number(b.latest.rating).toFixed(1) + '★' : '—' %><%- deltaText(dr, 1) %></td>
            <td class="num"><%= b.latest && b.latest.reviews != null ? num(b.latest.reviews) : '—' %><%- deltaText(dn) %></td>
            <td>
              <% if (!b.place_id) { %><span class="pub">Chưa theo dõi</span>
              <% } else if (b.sync_status === 'error') { %><span class="pub pub-fail">Lỗi</span><small class="block down"><%= b.sync_error %></small>
              <% } else if (b.last_synced_at) { %><span class="pub pub-done">Tự động</span><small class="block muted"><%= d.dmyhm(b.last_synced_at) %></small>
              <% } else { %><span class="pub pub-wait">Chờ cập nhật</span><% } %>
            </td>
            <td>
              <% if (editable && conn.configured) { %>
                <form method="post" action="/channels/google/link" class="inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <input type="hidden" name="branch_id" value="<%= b.id %>">
                  <label class="sr-only" for="link-<%= b.id %>">Link Google Maps của <%= b.name %></label>
                  <input id="link-<%= b.id %>" class="input-sm" type="url" name="link" required value="<%= b.maps_url || '' %>" placeholder="https://maps.app.goo.gl/…">
                  <button class="btn btn-small" type="submit" data-busy="Đang lấy…"><%= b.place_id ? 'Đổi' : 'Lưu' %></button>
                </form>
                <% if (b.extra && b.extra.profile && b.extra.profile.address) { %><small class="muted block">Đang theo dõi: <%= b.extra.profile.name %>, <%= b.extra.profile.address %></small><% } %>
              <% } else if (b.maps_url) { %><a href="<%= b.maps_url %>" target="_blank" rel="noopener">Mở trên Google Maps</a><% } else { %><span class="muted">Chưa có</span><% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
    <p class="hint pad">Lấy link: mở Google Maps, tìm đúng chi nhánh, bấm Chia sẻ, Sao chép đường liên kết. Bấm tên chi nhánh để xem biểu đồ và đánh giá gần đây.</p>
  <% } %>
</section>

<section class="panel panel-flush" id="doi-thu">
  <div class="panel-head pad">
    <h2>So sánh với đối thủ</h2>
    <span class="muted small">Điểm và số đánh giá cập nhật cùng lúc với chi nhánh</span>
  </div>
  <% const fmtRating = (t) => (t.latest && t.latest.rating != null ? Number(t.latest.rating).toFixed(1) + '★' : '—'); %>
  <% const fmtReviews = (t) => (t.latest && t.latest.reviews != null ? num(t.latest.reviews) : '—'); %>
  <% const fmtGrowth = (t) => (t.growth30 == null ? '—' : (t.growth30 > 0 ? '+' : '') + num(t.growth30)); %>
  <table class="table table-rows rival-table">
    <thead><tr><th>Khách sạn</th><th class="num">Điểm</th><th class="num">Đánh giá</th><th class="num">Đánh giá mới 30 ngày</th><th><span class="sr-only">Bỏ</span></th></tr></thead>
    <% for (const g of comparison) { %>
      <tbody>
        <tr class="rival-own">
          <td><strong><%= g.branch.name %></strong> <span class="tag">Bin Bin</span></td>
          <td class="num"><strong><%= fmtRating(g.own) %></strong></td>
          <td class="num"><%= fmtReviews(g.own) %></td>
          <td class="num"><%= fmtGrowth(g.own) %></td>
          <td></td>
        </tr>
        <% for (const r of g.rivals) {
             const ownR = g.own.latest && g.own.latest.rating != null ? Number(g.own.latest.rating) : null;
             const rivalR = r.latest && r.latest.rating != null ? Number(r.latest.rating) : null;
             const ahead = ownR != null && rivalR != null && rivalR > ownR; %>
          <tr>
            <td class="rival-name"><% if (r.maps_url) { %><a href="<%= r.maps_url %>" target="_blank" rel="noopener"><%= r.name %></a><% } else { %><%= r.name %><% } %>
              <% if (r.sync_status === 'error') { %><small class="block down"><%= r.sync_error %></small><% } %></td>
            <td class="num<%= ahead ? ' down' : '' %>"><%= fmtRating(r) %></td>
            <td class="num"><%= fmtReviews(r) %></td>
            <td class="num"><%= fmtGrowth(r) %></td>
            <td class="right">
              <% if (editable) { %><form method="post" action="/channels/google/competitors/<%= r.id %>/delete" data-confirm="Bỏ theo dõi <%= r.name %>?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-small btn-quiet" type="submit">Bỏ</button></form><% } %>
            </td>
          </tr>
        <% } %>
        <% if (!g.rivals.length) { %><tr><td colspan="5" class="muted small rival-name">Chưa có đối thủ nào cho chi nhánh này.</td></tr><% } %>
      </tbody>
    <% } %>
  </table>
  <% if (editable && conn.configured && snap.length) { %>
    <form method="post" action="/channels/google/competitors" class="inline-form pad rival-add">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="sr-only" for="rival-branch">So với chi nhánh</label>
      <select id="rival-branch" name="branch_id"><% for (const b of snap) { %><option value="<%= b.id %>"><%= b.name %></option><% } %></select>
      <label class="sr-only" for="rival-link">Link Google Maps của đối thủ</label>
      <input id="rival-link" class="input-sm" type="url" name="link" required placeholder="Dán link Google Maps của khách sạn đối thủ">
      <button class="btn btn-small" type="submit" data-busy="Đang lấy…"><%- icon('plus') %> Thêm đối thủ</button>
    </form>
  <% } %>
  <p class="hint pad">Số đỏ là đối thủ đang có điểm cao hơn chi nhánh. Nên theo dõi 2–4 khách sạn cùng phân khúc gần mỗi chi nhánh.</p>
</section>

<div class="detail">
  <section class="panel ai-panel" id="ai">
    <div class="panel-head">
      <h2>Phân tích của AI</h2>
      <% if (insight) { %><span class="muted small"><%= d.dmyhm(insight.created_at) %></span><% } %>
    </div>
    <% if (insight) { %>
      <p class="ai-summary"><%= insight.summary %></p>
      <div class="ai-cols">
        <% if (insight.highlights.length) { %><div><h3>Điểm tốt</h3><ul><% for (const x of insight.highlights) { %><li><%= x %></li><% } %></ul></div><% } %>
        <% if (insight.concerns.length) { %><div><h3>Cần chú ý</h3><ul><% for (const x of insight.concerns) { %><li><%= x %></li><% } %></ul></div><% } %>
      </div>
      <% if (insight.recommendations.length) { %><div class="ai-reco"><h3>Nên làm tuần này</h3><ul><% for (const x of insight.recommendations) { %><li><%= x %></li><% } %></ul></div><% } %>
    <% } else if (!aiConfigured) { %>
      <p class="empty">Chưa bật phân tích AI. Quản trị viên cần thêm <code>ANTHROPIC_API_KEY</code> vào biến môi trường.</p>
    <% } else { %>
      <p class="empty">AI so sánh điểm, số đánh giá và nội dung đánh giá giữa các chi nhánh, mỗi tuần một lần.</p>
    <% } %>
    <% if (aiConfigured && editable) { %>
      <form method="post" action="/channels/google/analyze" class="ai-run">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn btn-small" type="submit" data-busy="AI đang phân tích…"><%= insight ? 'Phân tích lại' : 'Phân tích ngay' %></button>
        <span class="hint">Mất khoảng 20–60 giây.</span>
      </form>
    <% } %>
  </section>

  <aside class="stack">
    <section class="panel stack">
      <h2>Phụ trách kênh</h2>
      <% if (editable) { %>
        <form method="post" action="/channels/google/account" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="display_name" value="<%= account.display_name || '' %>">
          <label class="field"><span>Người phụ trách</span>
            <select name="owner_id"><option value="">Chưa phân công</option>
              <% for (const u of users) { %><option value="<%= u.id %>"<%= Number(account.owner_id) === Number(u.id) ? ' selected' : '' %>><%= u.name %></option><% } %>
            </select>
          </label>
          <label class="field"><span>Ghi chú</span><textarea name="notes" rows="3" placeholder="Quy định trả lời đánh giá, ai trực chi nhánh nào…"><%= account.notes || '' %></textarea></label>
          <button class="btn" type="submit">Lưu</button>
        </form>
      <% } else { %>
        <p><%= account.owner_name || 'Chưa phân công' %></p>
      <% } %>
      <p class="hint"><%= ch.tips %></p>
    </section>
  </aside>
</div>
<%- include('../partials/bottom') %>
