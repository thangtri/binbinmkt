<%- include('../partials/top') %>
<header class="page-head">
  <div><h1>Tài khoản</h1><p class="sub">Ai được vào hệ thống và làm được gì</p></div>
</header>

<div class="detail">
  <section class="panel panel-flush">
    <table class="table table-rows">
      <thead><tr><th>Người dùng</th><th>Vai trò</th><th>Đăng nhập gần nhất</th><th><span class="sr-only">Sửa</span></th></tr></thead>
      <tbody>
        <% for (const u of users) { %>
          <tr class="<%= Number(u.active) ? '' : 'is-muted' %>">
            <td><strong><%= u.name %></strong><small class="muted block"><%= u.email %></small></td>
            <td><%= C.ROLES[u.role] ? C.ROLES[u.role].label : u.role %><%= Number(u.active) ? '' : ' (đã khoá)' %></td>
            <td class="nowrap"><%= u.last_login_at ? d.dmyhm(u.last_login_at) : 'Chưa đăng nhập' %></td>
            <td class="right">
              <details class="row-edit">
                <summary class="btn btn-small btn-quiet">Sửa</summary>
                <div class="row-edit-body">
                  <form method="post" action="/users/<%= u.id %>" class="stack">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <label class="field"><span>Tên</span><input type="text" name="name" value="<%= u.name %>" required></label>
                    <label class="field"><span>Vai trò</span>
                      <select name="role"><% for (const r of Object.values(C.ROLES)) { %><option value="<%= r.key %>"<%= u.role === r.key ? ' selected' : '' %>><%= r.label %></option><% } %></select>
                    </label>
                    <label class="field"><span>Đặt mật khẩu mới</span><input type="password" name="password" autocomplete="new-password" minlength="8" placeholder="Để trống nếu không đổi"></label>
                    <label class="check"><input type="checkbox" name="active" value="1"<%= Number(u.active) ? ' checked' : '' %><%= u.id === user.id ? ' disabled' : '' %>> Cho phép đăng nhập</label>
                    <% if (u.id === user.id) { %><input type="hidden" name="active" value="1"><% } %>
                    <button class="btn btn-small" type="submit">Lưu</button>
                  </form>
                </div>
              </details>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </section>

  <aside class="stack">
    <section class="panel stack">
      <h2>Thêm tài khoản</h2>
      <% if (error) { %><p class="field-error" role="alert"><%= error %></p><% } %>
      <form method="post" action="/users" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label class="field"><span>Họ tên</span><input type="text" name="name" value="<%= form.name %>" required></label>
        <label class="field"><span>Email</span><input type="email" name="email" value="<%= form.email %>" required></label>
        <label class="field"><span>Vai trò</span>
          <select name="role"><% for (const r of Object.values(C.ROLES)) { %><option value="<%= r.key %>"<%= form.role === r.key ? ' selected' : '' %>><%= r.label %></option><% } %></select>
        </label>
        <label class="field"><span>Mật khẩu tạm</span><input type="password" name="password" autocomplete="new-password" minlength="8" required><small>Ít nhất 8 ký tự. Người dùng tự đổi sau khi đăng nhập.</small></label>
        <button class="btn btn-primary" type="submit">Tạo tài khoản</button>
      </form>
    </section>
    <section class="panel">
      <h2>Quyền theo vai trò</h2>
      <dl class="kv kv-stack">
        <% for (const r of Object.values(C.ROLES)) { %><dt><%= r.label %></dt><dd><%= r.desc %></dd><% } %>
      </dl>
    </section>
  </aside>
</div>
<%- include('../partials/bottom') %>
