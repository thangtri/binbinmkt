<%- include('../partials/top') %>
<% const isNew = !ev.id; %>
<header class="page-head">
  <div><p class="crumbs"><a href="/events">Sự kiện</a></p><h1><%= isNew ? 'Thêm sự kiện' : 'Sửa sự kiện' %></h1></div>
</header>
<% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>

<div class="detail">
  <form method="post" action="<%= isNew ? '/events' : '/events/' + ev.id %>" class="panel stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="field"><span>Tên sự kiện</span><input type="text" name="title" value="<%= ev.title %>" maxlength="200" required placeholder="Ví dụ: Lễ hội pháo hoa, Combo hè cho gia đình"></label>
    <label class="field"><span>Loại</span>
      <select name="kind">
        <% for (const k of Object.values(C.EVENT_KINDS)) { %><option value="<%= k.key %>"<%= ev.kind === k.key ? ' selected' : '' %>><%= k.label %></option><% } %>
      </select>
    </label>
    <div class="row-2">
      <label class="field"><span>Từ ngày</span><input type="date" name="start_date" value="<%= ev.start_date %>" required></label>
      <label class="field"><span>Đến ngày</span><input type="date" name="end_date" value="<%= ev.end_date %>"></label>
    </div>
    <label class="check"><input type="checkbox" name="recurring" value="1"<%= Number(ev.recurring) ? ' checked' : '' %>> Lặp lại hằng năm vào cùng ngày dương lịch</label>
    <p class="hint">Lễ theo âm lịch (Tết, Trung thu) đổi ngày dương mỗi năm, nên nhập riêng từng năm.</p>
    <label class="field"><span>Mô tả, ý tưởng nội dung</span><textarea name="description" rows="5"><%= ev.description || '' %></textarea></label>
    <div class="toolbar">
      <button class="btn btn-primary" type="submit"><%= isNew ? 'Thêm sự kiện' : 'Lưu' %></button>
      <a class="btn btn-quiet" href="/events">Huỷ</a>
    </div>
  </form>

  <% if (!isNew) { %>
    <aside class="stack">
      <section class="panel">
        <h2>Bài gắn với sự kiện</h2>
        <% if (!posts || !posts.length) { %>
          <p class="empty">Chưa có bài nào.</p>
        <% } else { %>
          <ul class="plain-list">
            <% for (const p of posts) { %>
              <li><a href="/posts/<%= p.id %>"><%= p.title %></a> <%- include('../partials/chips', { kind: 'status', value: p.status }) %> <span class="muted small"><%= p.scheduled_at ? d.dm(p.scheduled_at) : '' %></span></li>
            <% } %>
          </ul>
        <% } %>
        <% if (can('post:create')) { %><p><a class="btn btn-small" href="/posts/new?event=<%= ev.id %>">Soạn bài cho sự kiện này</a></p><% } %>
      </section>
      <form method="post" action="/events/<%= ev.id %>/delete" data-confirm="Xoá sự kiện “<%= ev.title %>”? Các bài liên quan vẫn được giữ.">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn btn-danger-quiet" type="submit">Xoá sự kiện</button>
      </form>
    </aside>
  <% } %>
</div>
<%- include('../partials/bottom') %>
